;=============================================================
; 组 45 —— test_builtin_functions.cpp 的可观察内置函数语义
; 依据：test/data/functions/ 下对应函数文档，以及
; test_builtin_functions.cpp 的确定性求值断言。
; 函数目录、参数签名、AST 类型/arityError 留在 C++ 测试。
;=============================================================
@TEST_BUILTIN_CORE
#DIM FAILS
#DIM A
#DIM B
#DIM C
#DIM FLAG, 4
#DIMS WORDS, 5

;---- 数学函数 ----
CALL ASSERT_EQ, ABS(-5), 5, "ABS(-5)"
FAILS += RESULT
CALL ASSERT_EQ, SIGN(-3), -1, "SIGN(-3)"
FAILS += RESULT
CALL ASSERT_EQ, SIGN(0), 0, "SIGN(0)"
FAILS += RESULT
CALL ASSERT_EQ, SIGN(7), 1, "SIGN(7)"
FAILS += RESULT
CALL ASSERT_EQ, LIMIT(10, 0, 5), 5, "LIMIT 上界"
FAILS += RESULT
CALL ASSERT_EQ, LIMIT(-3, 0, 5), 0, "LIMIT 下界"
FAILS += RESULT
CALL ASSERT_EQ, MIN(3, 1, 2), 1, "MIN 可变参数"
FAILS += RESULT
CALL ASSERT_EQ, MAX(3, 1, 2), 3, "MAX 可变参数"
FAILS += RESULT
CALL ASSERT_EQ, POWER(2, 10), 1024, "POWER 函数"
FAILS += RESULT
CALL ASSERT_EQ, SQRT(16), 4, "SQRT"
FAILS += RESULT
CALL ASSERT_EQ, CBRT(27), 3, "CBRT"
FAILS += RESULT
CALL ASSERT_EQ, LOG10(1000), 3, "LOG10"
FAILS += RESULT
CALL ASSERT_EQ, EXPONENT(0), 1, "EXPONENT"
FAILS += RESULT
CALL ASSERT_EQ, GETBIT(5, 0), 1, "GETBIT 位0"
FAILS += RESULT
CALL ASSERT_EQ, GETBIT(5, 1), 0, "GETBIT 位1"
FAILS += RESULT
CALL ASSERT_EQ, GETBIT(5, 2), 1, "GETBIT 位2"
FAILS += RESULT
CALL ASSERT_EQ, INRANGE(3, 1, 5), 1, "INRANGE 命中"
FAILS += RESULT
CALL ASSERT_EQ, INRANGE(9, 1, 5), 0, "INRANGE 未命中"
FAILS += RESULT

;---- 字符串长度、位置、转换和格式 ----
CALL ASSERT_EQ, STRLENS("AB"), 2, "STRLENS ASCII"
FAILS += RESULT
CALL ASSERT_EQ, STRLENS("あ"), 2, "STRLENS Shift-JIS 字节长度"
FAILS += RESULT
CALL ASSERT_EQ, STRLENSU("あ"), 1, "STRLENSU 字符长度"
FAILS += RESULT
CALL ASSERT_SEQ, SUBSTRING("あいう", 2, 2), "い", "SUBSTRING 按语言字节位置"
FAILS += RESULT
CALL ASSERT_SEQ, SUBSTRINGU("abcde", 1, 3), "bcd", "SUBSTRINGU"
FAILS += RESULT
CALL ASSERT_EQ, STRFIND("あいう", "う"), 4, "STRFIND"
FAILS += RESULT
CALL ASSERT_EQ, STRFINDU("abcde", "cd"), 2, "STRFINDU"
FAILS += RESULT
CALL ASSERT_EQ, STRCOUNT("abcabc", "abc"), 2, "STRCOUNT"
FAILS += RESULT
CALL ASSERT_SEQ, TOSTR(123), "123", "TOSTR"
FAILS += RESULT
CALL ASSERT_EQ, TOINT("123"), 123, "TOINT 数字"
FAILS += RESULT
CALL ASSERT_EQ, TOINT("abc"), 0, "TOINT 非数字"
FAILS += RESULT
CALL ASSERT_EQ, ISNUMERIC("12.5"), 1, "ISNUMERIC 数字"
FAILS += RESULT
CALL ASSERT_EQ, ISNUMERIC("1a"), 0, "ISNUMERIC 非数字"
FAILS += RESULT
CALL ASSERT_SEQ, TOUPPER("aB"), "AB", "TOUPPER"
FAILS += RESULT
CALL ASSERT_SEQ, TOLOWER("aB"), "ab", "TOLOWER"
FAILS += RESULT
CALL ASSERT_SEQ, TOFULL("A1"), "Ａ１", "TOFULL"
FAILS += RESULT
CALL ASSERT_SEQ, TOHALF("Ａ１"), "A1", "TOHALF"
FAILS += RESULT
CALL ASSERT_SEQ, REPLACE("abcab", "ab", "X"), "XcX", "REPLACE"
FAILS += RESULT
CALL ASSERT_SEQ, UNICODE(65), "A", "UNICODE"
FAILS += RESULT
CALL ASSERT_EQ, ENCODETOUNI("A"), 65, "ENCODETOUNI 函数"
FAILS += RESULT
CALL ASSERT_SEQ, CONVERT(255, 16), "ff", "CONVERT 十六进制"
FAILS += RESULT
CALL ASSERT_SEQ, CONVERT(5, 2), "101", "CONVERT 二进制"
FAILS += RESULT
CALL ASSERT_SEQ, CHARATU("abc", 1), "b", "CHARATU"
FAILS += RESULT
CALL ASSERT_SEQ, MONEYSTR(100), "$100", "MONEYSTR 使用示例工程默认货币单位"
FAILS += RESULT
CALL ASSERT_SEQ, BARSTR(5, 10, 10), "[*****.....]", "BARSTR"
FAILS += RESULT

;---- STRFORM：运行期展开与宽度格式 ----
FLAG:0 = 1
CALL ASSERT_SEQ, STRFORM("HP={FLAG:0}"), "HP=1", "STRFORM 运行期展开"
FAILS += RESULT
CALL ASSERT_SEQ, STRFORM("{123,5,RIGHT}"), "  123", "STRFORM 数值右对齐"
FAILS += RESULT

;---- 数组聚合、查找与比较 ----
FLAG:0 = 1
FLAG:1 = 2
FLAG:2 = 3
FLAG:3 = 0
CALL ASSERT_EQ, SUMARRAY(FLAG, 0, 3), 6, "SUMARRAY"
FAILS += RESULT
CALL ASSERT_EQ, MAXARRAY(FLAG, 0, 4), 3, "MAXARRAY"
FAILS += RESULT
CALL ASSERT_EQ, MINARRAY(FLAG, 0, 3), 1, "MINARRAY"
FAILS += RESULT
CALL ASSERT_EQ, INRANGEARRAY(FLAG, 2, 4, 0, 4), 2, "INRANGEARRAY"
FAILS += RESULT
CALL ASSERT_EQ, MATCH(FLAG, 2, 0, 4), 1, "MATCH"
FAILS += RESULT
CALL ASSERT_EQ, FINDELEMENT(FLAG, 3, 0, 4), 2, "FINDELEMENT"
FAILS += RESULT
CALL ASSERT_EQ, FINDLASTELEMENT(FLAG, 3, 0, 4), 2, "FINDLASTELEMENT"
FAILS += RESULT
CALL ASSERT_EQ, GROUPMATCH(1, 1, 2, 1), 2, "GROUPMATCH"
FAILS += RESULT
CALL ASSERT_EQ, NOSAMES(1, 2, 1), 0, "NOSAMES 有重复"
FAILS += RESULT
CALL ASSERT_EQ, NOSAMES(1, 2, 3), 1, "NOSAMES 全不同"
FAILS += RESULT
CALL ASSERT_EQ, ALLSAMES(1, 1, 1), 1, "ALLSAMES 全相同"
FAILS += RESULT
CALL ASSERT_EQ, ALLSAMES(1, 2, 1), 0, "ALLSAMES 有不同"
FAILS += RESULT

RETURN FAILS
