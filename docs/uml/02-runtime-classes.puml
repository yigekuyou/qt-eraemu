@startuml 02-runtime-classes
' 无 graphviz(dot) 时用 PlantUML 内置 smetana 布局引擎
!pragma layout smetana
' emuera —— 运行期执行核心：ExecutionEngine 装配，ScriptRunner 单步状态机
' 渲染：plantuml -tpng docs/uml/02-runtime-classes.puml
title 运行期执行核心类图

package "GameProc" {
  class EraEngine {
    - m_executionEngine : ExecutionEngine
    - m_parseTable : EraParseTable
    + loadAsync(dir)
    + reload()
  }

  class ExecutionEngine {
    - m_erbLoader : ErbLoader
    - m_parseTable : EraParseTable
    - m_activeScope : eravar::ScopeId   ' 本节指令的作用域（RAII 设置）
    + loadScripts(dir) : bool
    + executeLogicalLine(line)
    + executeInstruction(line, scope)
    + writeLhs(ref, value)        ' 转调 VariableStorage::writeIntByName
    + getErbLoader() : ErbLoader
  }

  class ScriptRunner {
    - m_table : EraParseTable
    - m_storage : VariableStorage
    - m_currentScopeId : eravar::ScopeId  ' 只在换函数时更新
    - m_loops : QList<LoopFrame>
    + runToCompletion() : ExecState
    - stepOnce() : bool
    - readIntVar(name, indices) : qint64        ' 转调 readIntByName(scope)
    - writeIntVar(name, indices, value)         ' 转调 writeIntByName(scope)
    - readIntVarAccess(node, indices) : qint64  ' 转调 readIntNode(scope)
    - writeIntVarAccess(node, indices, value)   ' 转调 writeIntNode(scope)
    - writeLoopCounter(counter, value)
  }

  class ProcessState {
    + SystemStateCode 状态机
    + 当前函数 / 返回值
    + 运行上下文
  }

  struct LoopFrame {
    kind : Kind
    startLine / endLine / depth : int
    script : QString
    counter : Operand
    value / end / step : qint64
  }

  class ExtensionRegistry
}

EraEngine *-- ExecutionEngine
EraEngine --> EraParseTable
ExecutionEngine --> ScriptRunner
ExecutionEngine --> ExtensionRegistry : 扩展语句
ScriptRunner *-- LoopFrame
ScriptRunner --> ProcessState : 状态迁移
ScriptRunner --> EraParseTable : 取已分词的行
ScriptRunner --> VariableStorage

note right of ScriptRunner
  存取只有一条通路（本轮去重后）：
  · 带节点的读写 → ExpressionEvaluator::readIntNode / writeIntNode
    （AccessKind 查表分派，FOR·NEXT 与表达式共用）
  · 按名的读写 → VariableStorage::readIntByName / writeIntByName
  ScriptRunner 的同名成员只剩转调，不再各自实现一份 if 链。

  作用域是**参数**：m_currentScopeId 在换函数时
  （enterCall / ownerFunction 变化）intern 一次，
  之后每个求值入口显式传下去。
  求值器不再读 storage 里的「当前作用域」，
  所以也再没有「作用域守卫」那一层。

  循环变量写入语义：
  writeLoopCounter = 在计数器自身的固定下标上
  写入「循环值」——值不是下标。
  （曾有「循环值越界」检查，因此误报，已删除）

  位置推进（advance / setPosition / CALL / RETURN / JUMP）
  本类只按 EraParseTable 的 public 方法调用：
  状态是 PositionState（纯数据），转移是 position 的自由函数，
  类里只剩「打包视图 + 按 Effects emit」（见 01）。
end note

note bottom of ProcessState
  ExecState / SystemStateCode 由 ProcessState 持有，
  ScriptRunner::stepOnce 每步读取并推进。
end note
@enduml