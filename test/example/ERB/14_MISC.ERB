;=============================================================
; [14] 剩余命令（C# 命令表里、手写组尚未触及且可安全调用的）
;
; 覆盖：TRYGOTO / TRYJUMP / JUMPFORM / TRYJUMPFORM /
;       TRYCGOTO / TRYCGOTOFORM / TRYCJUMPFORM / TRYCCALLFORM /
;       PRINT_IMG / PRINT_RECT / PRINT_SPACE / PRINTDATAW /
;       ADDSPCHARA / ADDDEFCHARA / CALLEVENT
;=============================================================
@TEST_MISC
#DIM NONG
#DIMS S

PRINTL == 组14：剩余命令 ==

;---- TRYGOTO：目标存在则跳转 ----
TRYGOTO MISC_GOTO_HIT
CALL ASSERT_TRUE, 0, @"TRYGOTO 未跳转（不应发生）"
NONG += RESULT
$MISC_GOTO_HIT
CALL ASSERT_TRUE, 1, @"TRYGOTO 跳到 $MISC_GOTO_HIT"
NONG += RESULT

;---- TRYGOTO：目标不存在则静默跳过 ----
TRYGOTO MISC_NO_SUCH_LABEL
CALL ASSERT_TRUE, 1, @"TRYGOTO 目标不存在时静默跳过"
NONG += RESULT

;---- TRYJUMP / JUMPFORM / TRYJUMPFORM（JUMP 系：不返回）----
CALL SUB_MISC_JUMPFORM
CALL ASSERT_EQ, RESULT, 14, @"JUMPFORM 到带 FORM 的函数名"
NONG += RESULT
CALL SUB_MISC_TRYJUMP
CALL ASSERT_EQ, RESULT, 15, @"TRYJUMP 到函数"
NONG += RESULT
CALL SUB_MISC_TRYJUMPFORM
CALL ASSERT_EQ, RESULT, 16, @"TRYJUMPFORM 到 FORM 函数名"
NONG += RESULT

;---- TRYCGOTO / TRYCGOTOFORM（TRYC 变体：失败落 CATCH）----
TRYCGOTO MISC_NO_SUCH
CATCH
	PRINTL （TRYCGOTO 失败 -> CATCH 体）
ENDCATCH
CALL ASSERT_TRUE, 1, @"TRYCGOTO 失败进 CATCH"
NONG += RESULT
TRYCGOTOFORM MISC_NO_SUCH_%TOSTR(1)%
CATCH
	PRINTL （TRYCGOTOFORM 失败 -> CATCH 体）
ENDCATCH
CALL ASSERT_TRUE, 1, @"TRYCGOTOFORM 失败进 CATCH"
NONG += RESULT

;---- TRYCJUMPFORM / TRYCCALLFORM ----
CALL SUB_MISC_TRYCJUMPFORM
CALL ASSERT_EQ, RESULT, 17, @"TRYCJUMPFORM 命中"
NONG += RESULT
TRYCCALLFORM MISC_FUNC_%TOSTR(17)%
CATCH
	PRINTL （不应进入 CATCH）
ENDCATCH
CALL ASSERT_EQ, RESULT, 17, @"TRYCCALLFORM 命中并返回 17"
NONG += RESULT

;---- PRINT_IMG / PRINT_RECT / PRINT_SPACE（行内图形；各自单独成行，避免重叠告警）----
; 资源名要用**字符串表达式**：带引号（或字符串变量/拼接）。
; `PRINT_IMG 裸标识符` 会被当整数表达式求值 -> 0 -> QML 去找 image://emuera/0
;（C# 侧这种情况是「标识符未定义」错误，我们保留解析期告警）。
PRINT_IMG "no_such_image_resource"
PRINTL
PRINT_RECT 20
PRINTL
PRINT_RECT 0, 0, 20, 20
PRINTL
PRINT_SPACE 10
PRINTL
CALL ASSERT_TRUE, 1, @"PRINT_IMG / PRINT_RECT / PRINT_SPACE 不报错"
NONG += RESULT

;---- PRINTDATAW（PRINTDATA 的 W 变体：显示后等待）----
PRINTDATAW
	DATA 覆盖项甲
	DATA 覆盖项乙
ENDDATA
CALL ASSERT_TRUE, 1, @"PRINTDATAW 执行完毕"
NONG += RESULT

;---- ADDSPCHARA / ADDDEFCHARA ----
DELALLCHARA
ADDSPCHARA 0
CALL ASSERT_EQ, CHARANUM, 1, @"ADDSPCHARA 追加 SP 角色"
NONG += RESULT
ADDDEFCHARA
CALL ASSERT_TRUE, CHARANUM >= 1, @"ADDDEFCHARA 追加默认角色"
NONG += RESULT
DELALLCHARA

;---- CALLEVENT（调用事件函数；不存在的事件函数静默跳过）----
CALLEVENT MISC_NO_SUCH_EVENT
CALL ASSERT_TRUE, 1, @"CALLEVENT 未定义事件时静默跳过"
NONG += RESULT

;---- CALLEVENT（事件函数链：#PRI -> 普通 -> #LATER 依次执行后回到下一行）----
;EVENTTURNEND 在事件名表里，三份同名 @EVENTTURNEND 组成事件链。
;TFLAG:9 用作累计器（组内其它断言不占用）。
TFLAG:9 = 0
CALLEVENT EVENTTURNEND
CALL ASSERT_EQ, TFLAG:9, 7, @"CALLEVENT 事件链按 #PRI/普通/#LATER 顺序执行（1+2+4）"
NONG += RESULT

RETURN NONG

;=============================================================
; CALLEVENT 用的同名事件函数（EVENTTURNEND）
;=============================================================
@EVENTTURNEND
#PRI
TFLAG:9 += 1
RETURN 0

@EVENTTURNEND
TFLAG:9 += 2
RETURN 0

@EVENTTURNEND
#LATER
TFLAG:9 += 4
RETURN 0

;=============================================================
; 被调/被跳函数
;=============================================================
@MISC_FUNC_17
RETURN 17

@SUB_MISC_JUMPFORM
JUMPFORM MISC_TARGET_%TOSTR(14)%
RETURN -1

@MISC_TARGET_14
RETURN 14

@SUB_MISC_TRYJUMP
TRYJUMP MISC_TARGET_15
RETURN -1

@MISC_TARGET_15
RETURN 15

@SUB_MISC_TRYJUMPFORM
TRYJUMPFORM MISC_TARGET_%TOSTR(16)%
RETURN -1

@MISC_TARGET_16
RETURN 16

@SUB_MISC_TRYCJUMPFORM
TRYCJUMPFORM MISC_TARGET_%TOSTR(17)%
RETURN -1

@MISC_TARGET_17
RETURN 17
