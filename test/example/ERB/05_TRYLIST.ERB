;=============================================================
; [5] TRYCALLLIST / TRYJUMPLIST / TRYGOTOLIST + FUNC / ENDFUNC
;     （本次忠实性补齐的核心：三游戏未用、但 C# 全量支持）
;=============================================================
@TEST_TRYLIST
#DIM NONG

PRINTL == 组5：TRY*LIST + FUNC/ENDFUNC ==

;---- TRYCALLLIST：命中第 2 个候选（候选 1 不存在）----
TRYCALLLIST
	FUNC NO_SUCH_A
	FUNC LISTB
	FUNC LISTC
ENDFUNC
CALL ASSERT_EQ, RESULT, 200, @"TRYCALLLIST 命中 LISTB（跳过不存在的候选）"
NONG += RESULT

;---- TRYCALLLIST：候选带实参 ----
TRYCALLLIST
	FUNC LISTARG(1, 2)
	FUNC LISTC
ENDFUNC
CALL ASSERT_EQ, RESULT, 3, @"TRYCALLLIST 候选带实参 LISTARG(1,2)"
NONG += RESULT

;---- TRYCALLLIST：全部失败 -> ENDFUNC 之后继续 ----
TRYCALLLIST
	FUNC NO_SUCH_X
	FUNC NO_SUCH_Y
ENDFUNC
CALL ASSERT_TRUE, 1, @"TRYCALLLIST 全部失败落到 ENDFUNC 之后"
NONG += RESULT

;---- GOTOLIST（TRYGOTOLIST 的宽松别名，同样只在本函数内找 $ 标签）----
GOTOLIST
	FUNC $GL_ALIAS_HIT
	FUNC $GL_TAIL
ENDFUNC
CALL ASSERT_TRUE, 0, @"GOTOLIST 命中 $ 标签后不应落到失败路径"
NONG += RESULT
$GL_ALIAS_HIT
CALL ASSERT_TRUE, 1, @"GOTOLIST 别名命中 $GL_ALIAS_HIT"
NONG += RESULT

;---- TRYJUMPLIST：JUMP 语义（目标 RETURN 直接回到调用者）----
CALL SUB_TRYJUMPLIST
CALL ASSERT_EQ, RESULT, 300, @"TRYJUMPLIST 命中 LISTJUMP，RETURN 回调用者"
NONG += RESULT

;---- TRYGOTOLIST：命中 $ 标签（无参数候选）----
TRYGOTOLIST
	FUNC $GL_NOPE
	FUNC $GL_HIT
	FUNC $GL_TAIL
ENDFUNC
;全部失败的落点（不应走到：$GL_HIT 存在）
CALL ASSERT_TRUE, 0, @"TRYGOTOLIST 不应落到失败路径"
NONG += RESULT
$GL_HIT
CALL ASSERT_TRUE, 1, @"TRYGOTOLIST 跳到 $GL_HIT"
NONG += RESULT

;---- TRYGOTOLIST：全部失败 -> ENDFUNC 之后（落到 $GL_TAIL 前的断言）----
TRYGOTOLIST
	FUNC $GL_NOPE2
ENDFUNC
CALL ASSERT_TRUE, 1, @"TRYGOTOLIST 全部失败落到 ENDFUNC 之后"
NONG += RESULT
$GL_TAIL
CALL ASSERT_TRUE, 1, @"ENDFUNC 兜底（顺序落入不报错）"
NONG += RESULT

RETURN NONG

@SUB_AFTER_GL_NOPE2
RETURN 0

;=============================================================
; 被调函数们
;=============================================================
@LISTB
RETURN 200

@LISTC
RETURN 299

@LISTARG(A, B)
RETURN A + B

@SUB_TRYJUMPLIST
TRYJUMPLIST
	FUNC NO_SUCH_J
	FUNC LISTJUMP
	FUNC LISTC
ENDFUNC
RETURN -1

@LISTJUMP
RETURN 300
