;=============================================================
; COLUMN_LIB.ERB —— 手写夹具：EmueraEE「カラム機能試作ライブラリ」的函数实现
;
; 语义来源：eraTW/README集/EmueraEE Readme/read me(COLUMN_LIB).txt
;   （原文只给语义，不给实现；本仓库 C# 源码里没有 COLUMN*）。逐条：
;     COLUMNCREATE(ID)          —— 新建列；**已存在返回 0**，新建返回非 0
;     COLUMNRESIZE(ID, w, h)    —— 尺寸（全角 1 字 = 1000）
;     COLUMNMOVE(ID, X, Y)      —— 位置（同单位）
;     COLUMNCOLOR(ID, 色名)     —— 文字色（字符串，COLOR_FROMNAME 兼容）
;     COLUMNBGCOLOR(ID, 色名)   —— 背景色（同上）
;     COLUMNDIRECTION(ID, 0/1)  —— 0=下→上（Emuera 式），1=上→下（文档式）
;     COLUMNPRINT/PRINTL/PRINTW(ID, s) —— 写一列；W 版追加后重绘
;     COLUMNWAIT                —— 重绘
;
; 原版用 GDRAWTEXT 把列画成文本位图区；本移植 GDRAWTEXT 仍是桩，故本夹具
; **不绘制**，只把状态写进 COLUMN_*（见 COLUMN_LIB.ERH），供组 38 断言。
; 这是「测试夹具」而非引擎实现：真实游戏会自带原版 COLUMN_LIB。
;=============================================================

@COLUMNCREATE(ID)
#DIM ID
IF ID < 0
	RETURN 0
ENDIF
IF ID >= 32
	RETURN 0
ENDIF
IF COLUMN_EXISTS:ID != 0
	RETURN 0
ENDIF
COLUMN_EXISTS:ID = 1
COLUMN_W:ID = 0
COLUMN_H:ID = 0
COLUMN_X:ID = 0
COLUMN_Y:ID = 0
COLUMN_DIRECTION:ID = 0
COLUMN_LINES:ID = 0
RETURN 1

@COLUMNRESIZE(ID, W, H)
#DIM ID
#DIM W
#DIM H
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
COLUMN_W:ID = W
COLUMN_H:ID = H
RETURN 1

@COLUMNMOVE(ID, X, Y)
#DIM ID
#DIM X
#DIM Y
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
COLUMN_X:ID = X
COLUMN_Y:ID = Y
RETURN 1

@COLUMNCOLOR(ID, C)
#DIM ID
#DIMS C
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
COLUMN_TEXTCOLOR:ID = C
RETURN 1

@COLUMNBGCOLOR(ID, C)
#DIM ID
#DIMS C
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
COLUMN_BGCOLOR:ID = C
RETURN 1

@COLUMNDIRECTION(ID, D)
#DIM ID
#DIM D
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
COLUMN_DIRECTION:ID = D
RETURN 1

@COLUMNPRINT(ID, S)
#DIM ID
#DIMS S
#DIM L
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
L = COLUMN_LINES:ID
COLUMN_BUFFER:ID:L += S
RETURN 1

@COLUMNPRINTL(ID, S)
#DIM ID
#DIMS S
#DIM L
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
L = COLUMN_LINES:ID
COLUMN_BUFFER:ID:L += S
COLUMN_LINES:ID += 1
RETURN 1

@COLUMNPRINTW(ID, S)
#DIM ID
#DIMS S
CALL COLUMNPRINTL, ID, S
COLUMN_REDRAWS += 1
RETURN 1

@COLUMNWAIT
COLUMN_REDRAWS += 1
RETURN 1

@COLUMNCLEAR(ID)
#DIM ID
#DIM I
IF COLUMN_EXISTS:ID == 0
	RETURN 0
ENDIF
FOR I, 0, 64
	COLUMN_BUFFER:ID:I = ""
NEXT
COLUMN_LINES:ID = 0
RETURN 1
