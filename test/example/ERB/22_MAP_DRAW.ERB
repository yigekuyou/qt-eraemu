;-----------------------------------------------------------
; 着色と置換（复刻 eraTW DRAW_MAP_BG_0；颜色常量 → 字面量）
;-----------------------------------------------------------
@DRAW_MAP_BG_TEST(SLICED)
#DIMS SLICED
#DIM CONST C_MUGEN = 0x4d5aaf
SELECTCASE SLICED
;▼着色
CASE "ｖ"
	SETCOLOR 0x2d8f46
	PRINTS SLICED
	RESETCOLOR
CASE "林", "木"
	SETCOLOR 0x0e791e
	PRINTS SLICED
	RESETCOLOR
CASE "森"
	SETCOLOR 0x04570c
	PRINTS SLICED
	RESETCOLOR
CASE "■", "│", "─", "┐", "┌", "└", "┘", "￣", "／", "＼", "ｘ", "目"
	SELECTCASE TFLAG:1
	CASE 2
		SETCOLOR C_MUGEN
	CASEELSE
		SETCOLOR 0x856022
	ENDSELECT
	PRINTS SLICED
	RESETCOLOR
CASE "□", "○", "┏", "┓", "┗", "┛", "〓"
	SELECTCASE TFLAG:1
	CASE 2
		SETCOLOR 0x706caa
	CASE 4, 0
		SETCOLOR C_MUGEN
	CASEELSE
		SETCOLOR 0x9b7a2e
	ENDSELECT
	PRINTS SLICED
	RESETCOLOR
CASE "|"
	SETCOLOR 0x9b7a2e
	PRINTS SLICED
	RESETCOLOR
CASE "γ", "⌒", "ヽ", "ゝ", "＿", "ノ"
	SELECTCASE TFLAG:1
	CASE 4, 0
		SETCOLOR C_MUGEN
	CASEELSE
		SETCOLOR 0x00a3af
	ENDSELECT
	PRINTS SLICED
	RESETCOLOR
CASE "石", "狛", "回", "┃", "┳", "┻", "┣", "┫"
	SELECTCASE TFLAG:1
	CASE 3
		SETCOLOR 0x9b7a2e
	CASEELSE
		SETCOLOR 0x9d9da8
	ENDSELECT
	PRINTS SLICED
	RESETCOLOR
CASE "━"
	SELECTCASE TFLAG:1
	CASE 2
		SETCOLOR 0x9d9da8
	CASEELSE
		SETCOLOR 0x9b7a2e
	ENDSELECT
	PRINTS SLICED
	RESETCOLOR
CASE "☆"
	SETCOLOR 0x7fcf53
	PRINTS SLICED
	RESETCOLOR
CASE "三"
	SETCOLOR C_MUGEN
	PRINTS SLICED
	RESETCOLOR
CASE "。"
	SETCOLOR 0xec6d71
	PRINTS SLICED
	RESETCOLOR
CASE "◆", "Π"
	SETCOLOR C_MUGEN
	PRINTS SLICED
	RESETCOLOR
CASE "●"
	SETCOLOR 0xd43a4c
	PRINTS SLICED
	RESETCOLOR
CASE "♨"
	SETCOLOR 0x59b9c6
	PRINTS SLICED
	RESETCOLOR
CASE "/", "X", "ヾ", "v", "ﾉ", "､"
	SETCOLOR 0x0e791e
	PRINTS SLICED
	RESETCOLOR
CASE "\"", "`", "ゞ", "ヽ", "y"
	SETCOLOR 0x9b7a2e
	PRINTS SLICED
	RESETCOLOR
;▼特殊な表示
CASE "#a", "#b", "#c", "#d", "#e", "#f", "#g", "#h", "#i", "#j", "#k", "#l", "#m", "#n", "#p"
	CALL MAP_PRINT_TEST(SLICED)
CASE "#A"
	SETCOLOR 0x5b8fc9
	PRINT □
	RESETCOLOR
CASE "#B"
	SETCOLOR C_MUGEN
	PRINT ■
	RESETCOLOR
CASE "#C"
	SETCOLOR C_MUGEN
	PRINT ニ
	RESETCOLOR
;ふつうの
CASEELSE
	PRINTS SLICED
ENDSELECT

;-----------------------------------------------------------
; #a-#p 地点标记（eraTW MAP_PRINT 的桩：着色打印原字符）
;-----------------------------------------------------------
@MAP_PRINT_TEST(SLICED)
#DIMS SLICED
SETCOLOR 0xd0a8ff
PRINTS SLICED
RESETCOLOR

;-----------------------------------------------------------
; 数字按钮（eraTW GETMAP 桩：保留 SETCOLOR+PRINTBUTTON+RESETCOLOR 主干）
;-----------------------------------------------------------
@GETMAP_TEST(ARG)
SETCOLOR 0x228b22
IF ARG > 9
	PRINTBUTTON TOSTR(ARG), ARG
ELSE
	PRINTBUTTON TOFULL(TOSTR(ARG)), ARG
ENDIF
RESETCOLOR
