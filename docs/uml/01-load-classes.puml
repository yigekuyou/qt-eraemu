@startuml 01-load-classes
!pragma layout smetana
' 装载期类型边界。具体步骤见 12-load-pipeline。
' 来源：Content/erb_loader.h, GameData/ast, GameProc/era_parse_table.h

title 装载期类型边界

package "Content" {
  class ErbLoader {
    + loadDirectory(dir) : bool
    + loadAsync(dir)
    + loadFile(path)
    .. loadProgress / loadCompleted ..
  }

  class SourceText
  class DeclarationScan
}

package "GameData/ast" {
  class AstBuilder {
    + build(source, position, resolve) : LogicalLine
  }
  class LogicalLine
  class VariableTable
  class ParseDiagnostics
}

package "GameProc" {
  class EraParseTable {
    + loadScript(name, lines, isHeader) : bool
    + buildScriptAst(name, lines) : BuiltScript
    + runLoadPasses()
    + lineAt(script, line) : LogicalLine*
    - m_loadPasses : QList<LoadPass>
  }
  class LoadPass
  class ParseChecks
}

ErbLoader --> SourceText : read / preprocess
ErbLoader --> DeclarationScan : scan declarations
ErbLoader --> AstBuilder : build lines
AstBuilder --> LogicalLine
EraParseTable *-- VariableTable
EraParseTable *-- ParseDiagnostics
EraParseTable *-- LoadPass
EraParseTable --> ParseChecks : read-only checks
EraParseTable --> LogicalLine : owns script lines
ErbLoader --> EraParseTable : merge loaded scripts
AstBuilder --> VariableTable : resolve declarations
LoadPass --> VariableTable : finalize types and scopes
LoadPass --> ParseDiagnostics : pass-owned sink
ParseChecks --> ParseDiagnostics : pass-owned sink

note right of ErbLoader
  Content owns file decoding, preprocessing and directory traversal.
  It does not own runtime execution or QML presentation.
end note

note right of EraParseTable
  This is the load orchestration boundary. It owns the script table,
  phase transitions and pass ordering; pass implementations live in
  GameProc/load_passes and parse_checks.
end note

legend bottom
  One responsibility per layer:
  Content reads, GameData/ast represents, GameProc finalizes.
  Runtime diagrams begin at 02-runtime-step.
endlegend
@enduml
