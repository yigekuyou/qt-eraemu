@startuml 03-expression-classes
' 无 graphviz(dot) 时用 PlantUML 内置 smetana 布局引擎
!pragma layout smetana
' emuera —— 表达式 AST / 变量访问描述符 / 求值器
' 渲染：plantuml -tpng docs/uml/03-expression-classes.puml
title 表达式 AST 与变量访问描述符

  class LogicalLine {
    kind : LineKind
    functionName : QString
    runnerInstruction : RunnerInstruction
    arguments : QList<Operand>
    condition : ExpressionNode*
    conditionNeedsScope : bool   ' 装载期一趟 OR 出来：这条条件求值要不要执行位置
    assignmentAsts : QList
    columnDefaults : QList
    ownerFunction : QString
    isError : bool
  }

  struct Operand {
    raw : QString
    ast : ExpressionNode*
    isVariable : bool
  }

  struct TypedArgument {
    kind : ArgKind
    params : QList
    exprs : QList
    typeOk : bool
  }

  abstract class ExpressionNode {
    + kind() : NodeKind
    + valueType() : OperandType
  }

  class LiteralNode
  class BinaryOpNode
  class UnaryOpNode
  class FunctionNode
  class IfNode
  class StrFormNode

  class VariableNode {
    name : QString
    dimension : int
    lengths : QList
    accessKind : AccessKind
    accessKey : VariableKey
    {static} + usesKey(kind) : bool   ' 哪些 kind 消费 accessKey
  }

  struct VariableKey {
    scopeId : quint32   ' 0 = 顶层（无私有作用域）
    nameId : quint32    ' 名字 intern 表的 id
    {static} + isPrivate() : bool
  }

  class NameInterner <<namespace eravar>> {
    + internName(upper) : quint32   ' 单调、不复用、线程安全
    + nameOf(id) : const QString&
    + makePrivateStorageKey(scope, name)
    ' 全仓库唯一知道 0x1F 的地方：
    ' 「作用域串 + 0x1F + 名字串」只在这里拼
  }

  enum AccessKind {
    Dynamic
    GlobalInt1 / 2 / 3
    GlobalStr1 / 2 / 3
    LocalSlot / ArgSlot
    LocalStr / ArgStr
    Param
    Pseudo
    System
    Chara
    Const
  }

  class ExpressionEvaluator {
    + evaluate(node, storage, gameBase, scope) : QVariant
    + evaluateInt(node, storage, out, scope) : bool
    + resolveIndices(node, storage, gameBase, scope) : QList
    + readIntNode(node, indices, scope) : qint64   ' 唯一整数读分派
    + writeIntNode(node, indices, value, scope)    ' 唯一整数写分派
    - evaluateVariable(node, storage, gameBase, scope) : QVariant
    - assignVariable(node, storage, gameBase, value, scope) : bool
    - resolverTable() : const QList<Resolver>  ' 20 行，顺序即语义
    - readKeyedInt / readKeyedStr / readKeyedLocalArgInt / readKeyedLocalArgStr
    - readParameter / readCharaData / readSlotNames / readConst
    - readGameBase / readLineCount / readRandom / readIntLimits / readRandData
    - readStringVariable / readLastLoad / readIndexedArray / readSimpleVariable
  }

  class VariableStorage {
    - m_intSlots / m_strSlots : QHash<QString>          ' 一个键一条扁平槽位序列（1D 与多维同一条）
    - m_charaIntSlots / m_charaStrSlots : QHash<QString> ' 角色号·stride + 元素偏移
    - m_csvIntSlots / m_csvStrSlots : QHash<QString>     ' 同布局的 COW 快照
    - m_geometries / m_charaGeometries : QHash           ' 取址几何（唯一写入点 installGeometry）
    - m_localIntVars / m_argIntVars : QList
    - m_systemIntVars / m_systemStrVars : QHash
    - m_privateNames : QHash   ' scopeId → (名字 → 存储键)，装载期安装
    - m_privateTableInstalled : bool
    - m_references / m_localAliases
    + setPrivateScope(function, names)          ' 只记当前帧（安装后无分配）
    + installPrivateScopeTable(table)           ' 装载期一次
    + privateScopeTableInstalled() : bool
    + saveReadiness() : SaveReadiness           ' 存档前置条件（显式）
    - resolveIntLocus(name, indices, scope) : IntLocus  ' 按名判定唯一定义点（整数侧，行序即语义）
    - IntLocus { kind, key, charaId, e0, e1, e2 }      ' 解析产物：位置是数据
    - IntLocusKind { Parameter, CharaInt1D/2D, CharaStrAsInt, Arg, Local, StringSlot, System, Global3D/2D/1D }
    - resolveStrLocus(nameOrKey, indices, scope, keyState) : StrLocus  ' 字符串侧唯一定义点
    - StrLocus { kind, key, x, charaSlot, elements }   ' 同一形态：解析产物是数据
    - StrLocusKind { NegativeIndex, LocalStr, ArgStr, SavedataText, CharaStr, GlobalStr }
    - StrKeyState { Name, ResolvedKey }   ' ResolvedKey = 键已解析，绝不再套 storageName
    - readStrLocus(locus, indices) : FlatStringValue   ' 读侧唯一施加点（switch，无 default）
    + readIntByName(name, indices, scope) : qint64   ' 唯一按名读原语（解析一次 → switch kind）
    + writeIntByName(name, indices, value, scope)    ' 唯一按名写原语（同一 IntLocus，无第二份顺序）
    ' 四个 switch 都无 default：漏一个 case 在 -Wswitch + -Werror 下编译失败
    + storageKeyFor(key) : const QString&       ' 唯一 id→存储串入口（记忆化）
    + shapeOf(name, scope) : ArrayShape         ' 形状唯一入口（声明 → 装载期尺寸表 → 多维几何）
    + allocatedSlots(key) : int                 ' 容器分配量（不是形状）
    - addressOf(geometry, indices) : qint64     ' 唯一取址：Σ idx[d]·strides[d]
    - roleSlotOf(geometry, chara, offset) : qint64   ' 唯一角色块：charaSlot·elementCount + offset
    + getGlobalInt1DRaw(key, x) / setGlobalInt1DRaw(key, x, v)
    + getStringSlotRaw(key, indices) : FlatStringValue   ' 键已解析 → ResolvedKey，不重解析
    + getStringSlot / setStringSlot(name, indices[, scope])
    ' 读/写不对称是 Era 语义、由护栏钉住：读越界给空不扩容，写按需扩容
    + getLocalInt / getArgInt / setLocalInt / setArgInt
  }

class GameBaseData

LogicalLine *-- Operand
LogicalLine *-- TypedArgument
LogicalLine --> ExpressionNode : condition / assignmentAsts
LogicalLine ..> VariableNode : conditionNeedsScope = OR needsExecutionScope(kind)
Operand --> ExpressionNode
TypedArgument --> Operand

ExpressionNode <|-- LiteralNode
ExpressionNode <|-- VariableNode
ExpressionNode <|-- BinaryOpNode
ExpressionNode <|-- UnaryOpNode
ExpressionNode <|-- FunctionNode
ExpressionNode <|-- IfNode
ExpressionNode <|-- StrFormNode

VariableNode *-- VariableKey
VariableNode ..> AccessKind : 装载期定型
VariableKey ..> NameInterner : id ↔ 名字
ExpressionEvaluator ..> VariableNode : 读 accessKind 分派
ExpressionEvaluator --> VariableStorage
ExpressionEvaluator --> GameBaseData
ExpressionEvaluator ..> LogicalLine : 执行时求值

legend bottom
  位置：LogicalLine / Operand / TypedArgument / 各 Node —— GameData/ast/
  ExpressionEvaluator —— GameData/ast/expression_evaluator
  VariableKey / NameInterner —— GameData/ast/name_interner
  VariableStorage / GameBaseData —— GameData/Variable/
endlegend

note right of VariableKey
  变量身份是**两个整数**，不是字符串：
  · 私有名 = { 函数 id, 名字 id }；裸名 = { 0, 名字 id }
  · 比较是 quint32 相等，不再是 QString 逐字符
  · 存储层仍用字符串键（存档格式不变），
    但 id → 串只在 storageKeyFor 一处发生
end note

note right of VariableStorage
  容器也只有一种形态：维数不决定容器，只决定取址几何
  （1D 是「无几何」的特例）。旧形态是 1D/2D/3D 三套平行容器，
  各有自己的取址与懒扩容规则，CHARADATA 还是每角色一套嵌套 QList。

  形状也是装载期事实，只有一个入口 `shapeOf`：
  `VARSIZE` 函数 / `VARSIZE` 语句 / `arraySize` / `arrayLengths` /
  多维下标翻译都读它；容器当前分配量（`allocatedSlots`）不是形状。
  私有名表是**装载期的静态事实**：
  * 由声明（scope == Local）建一次，随装载收尾安装进来
  * 安装后 setPrivateScope 只写 m_privateScopeName / m_privateScopeId，
    没有 insert / reserve / 循环 —— 换函数零分配
  * 正确性不再依赖调用方把 names 传全（漏一个名字会让
    那个变量静默退化成裸名，这是旧实现的静默失效模式）
end note

note bottom of NameInterner
  internName 只在装载期写入（并行装载下加锁）；
  nameOf 运行期只读。名字存 deque，
  引用在后续登记后仍然有效；id 单调、不复用。
  上一版把「函数名 + 0x1F + 名字」在两个地方各拼一次
  （computeVariableAccess 与 setPrivateScope），
  两处必须逐字节一致 —— 现在是同一个函数。
end note

note bottom of ExpressionEvaluator
  分派是**数据**，不是控制流：
  * resolverTable 一行一块，顺序与旧 if 链逐块对应；
    kinds 是位掩码，needsKey 标明该行是否消费 accessKey
  * 定型 kind（Global*/槽位）走前 4 行键直取；
    Param/Pseudo/System/Chara/Const 各自成行；
    Dynamic 命中全表（= 旧链原样），表尾两行是终局
  * 作用域是参数，不是 storage 里的环境状态：
    只有按名回退读它，键自足的节点不看它
  * 保留的第二道守卫：裸键下标数与维数不符 → 按名原语
end note
@enduml