;=============================================================
; [12/13] 破坏性指令：THROW / BEGIN
;
; 这两条不能放进「全部自动运行」路径 ——
;   * THROW  主动抛出脚本错误（C# CodeEE），会终止本次执行；
;   * BEGIN  切换游戏流程并**不返回**（BEGIN TITLE 回到标题画面）。
; 因此单独成组，用 `./test/run_example.sh 12` / `13` 单独运行：
;   * 12 -> BEGIN TITLE：应看到标题画面被重新绘制；
;   * 13 -> THROW      ：应看到「执行出错」，这是**预期**结果。
;=============================================================
@TEST_BEGIN
PRINTL == 组12：BEGIN（切换流程，不返回） ==
PRINTL 即将执行 BEGIN TITLE —— 应重新出现标题画面
BEGIN TITLE
PRINTL 不应执行到这里（BEGIN 不返回）
RETURN 0

@TEST_THROW
PRINTL == 组13：THROW（主动报错，终止本次执行） ==
PRINTL 即将执行 THROW —— 随后应看到「执行出错」，这是预期行为
THROW THROW 的测试消息：本行之后将进入错误状态
PRINTL 不应执行到这里（THROW 已终止执行）
RETURN 0

;-------------------------------------------------------------
; 追加的破坏性指令
;   * RESTART    回到当前函数第一行（真实实现，对齐 C# JumpTo(ParentLabelLine)）
;                —— 用「自重启一次」的子函数测：LOCAL 标记防止无限重启
;                （RESTART 是同帧跳转，LOCAL/ARG 跨重启保留）。
;   * FORCE_BEGIN / FORCE_QUIT / FORCE_QUIT_AND_RESTART /
;     QUIT_AND_RESTART / CLEARMEMORY / BREAKBUTTON   EE 命令 —— **已真实现**：
;       FORCE_QUIT 族与 QUIT 一样立即结束本次执行（组 12c 末尾触发，
;       `★不应出现★` 未被打印即通过）；FORCE_QUIT_AND_RESTART /
;       QUIT_AND_RESTART 另置重启标志（宿主 reload），见菜单 [36]/[37]；
;       FORCE_BEGIN 的 force 语义（跳过 __CAN_BEGIN__）由单测覆盖
;       （test_execution_chain：Shop_CallShowShop 状态下 BEGIN 失败 /
;        FORCE_BEGIN 成功）；CLEARMEMORY 为式中函数（裸写静默跳过）。
;   * DOTRAIN    仅训练流程状态合法（example 无 TRAINNAME，同样报错）——
;                预期「执行出错」，用 ./test/run_example.sh 19 单独跑。
;-------------------------------------------------------------
@TEST_RESTART
#DIM NONG
PRINTL == 组12b：RESTART（重启当前函数） ==
CALL DO_RESTART_ONCE
; 真重启：两次经过函数头 -> LOCAL:0 计到 2；没重启（掉下去）-> 只计到 1
CALL ASSERT_EQ, RESULT, 2, @"RESTART 重启了子函数一次（LOCAL 计数 = 2）"
NONG = RESULT
RETURN NONG

; 自重启一次：LOCAL:0 计数经过函数头的次数（RESTART 同帧跳转，LOCAL 保留）
@DO_RESTART_ONCE
LOCAL:0 = LOCAL:0 + 1
IF LOCAL:0 == 1
	RESTART
ENDIF
RETURN LOCAL:0

@TEST_DESTRUCTIVE_EE
#DIM NONG
PRINTL == 组12c：EE 破坏性命令（真实现：内存/日志族 + QUIT 族） ==

;---- 非终止段：内存族 / 日志族（真实现，断言语义）----
; GETMEMORYUSAGE()：进程 RSS（C# 用 WorkingSet64，语义同族）
CALL ASSERT_TRUE, GETMEMORYUSAGE() > 0, @"GETMEMORYUSAGE() > 0（当前进程内存用量）"
NONG += RESULT
; CLEARMEMORY()：回收并返回**释放的字节数**（C# GC.Collect 前后差值）——
; 刚跑完的值可能为 0（无可回收），断言「>= 0」。
CALL ASSERT_TRUE, CLEARMEMORY() >= 0, @"CLEARMEMORY() >= 0（返回释放字节数）"
NONG += RESULT
; BREAKBUTTON：作废画面上的按钮世代（GUI 后端专属）——留痕桩。
BREAKBUTTON
CALL ASSERT_TRUE, 1, @"BREAKBUTTON（GUI 桩）执行不报错"
NONG += RESULT
; 命令形态的 CLEARMEMORY（裸写）在 C# 里是**式中函数**，非法写法；
; 本移植按式中函数裸写静默跳过（不报错）。
CLEARMEMORY
CALL ASSERT_TRUE, 1, @"CLEARMEMORY 裸写（非 C# 合法形态）执行不报错"
NONG += RESULT

;先出汇总 —— 下面是终止段，执行到 QUIT 命令后脚本立即结束
CALL TEST_SUMMARY, NONG

;---- 终止段：FORCE_QUIT 真实现（不等待立即结束；组18 单跑到此为止）----
PRINTL [标记] FORCE_QUIT：以下应立即结束，★不应出现★ 的行不该被打印
FORCE_QUIT
PRINTL ★不应出现在这里★（FORCE_QUIT 未生效）
RETURN 0

@TEST_DOTRAIN
