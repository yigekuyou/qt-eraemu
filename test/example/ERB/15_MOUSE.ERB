;=============================================================
; [15] 鼠标 / 原始输入（INPUTMOUSEKEY）+ EE 输入族（真实现）
;
; INPUTMOUSEKEY 等鼠标/键盘 —— GUI 下必须手点；无 GUI 时用 test_cli 的
; `k <t> <r1> <r2> <r3> <r4>` 注入（x = 左键点击）。两种路径都测：
;   * 真实注入（k 1 10 10 1 0）→ RESULT:0 = 1（类型 = 鼠标左键）；
;   * 带超时（INPUTMOUSEKEY 50）→ 注入没来时超时自动继续，
;     C# 对齐：超时按 InputMouseKey(4,0,0,0,0) → RESULT:0 = 4。
; 注意顺序：**先注入后超时** —— 脚本序列里 k 在前，第一个 INPUTMOUSEKEY
; 吃注入；第二个 INPUTMOUSEKEY 时序列已空，靠超时自动继续。
; EE 输入族（BINPUT/INPUTANY/FLOWINPUT）现在有真实语义，注入序列在 k 之后：
;   `1` -> 第一个 INPUTANY 的整数分支；`s 任意文本` -> 第二个的字符串分支。
; 运行：./test/run_example.sh 15
;=============================================================
@TEST_MOUSE
#DIM NONG
#DIM SNAP

PRINTL == 组15：鼠标 / 原始输入（INPUTMOUSEKEY） ==

;---- 真实注入（test_cli `k 1 10 10 1 0`）----
PRINTL INPUTMOUSEKEY：等待鼠标/键盘（自动化时由 k 注入）
INPUTMOUSEKEY 0
CALL ASSERT_EQ, RESULT:0, 1, @"INPUTMOUSEKEY 收到注入 type=1"
NONG += RESULT

;---- EE 输入族（真实现：BINPUT 族 / INPUTANY）----
; BINPUT/BINPUTS：运行时点已按钮化的值才接受；没有按钮时**不等待**，
; 直接把缺省值写进 RESULT(S)（EE v31fix）。这里没有按钮 -> 走缺省路径。
BINPUT 7
CALL ASSERT_EQ, RESULT, 7, @"BINPUT 7：无按钮 -> 不等待，RESULT = 缺省 7"
NONG += RESULT
BINPUTS "缺省串"
CALL ASSERT_SEQ, RESULTS, "缺省串", @"BINPUTS：无按钮 -> RESULTS = 缺省串"
NONG += RESULT

;---- INPUTANY（EE v22）：整数/字符串双通道 ----
; 整数输入 -> RESULT（RESULTS 不动）；字符串输入 -> RESULTS（RESULT 不动）。
; 注入序列：`1`（整数）-> `s 任意文本`（字符串）。
; 注意：CALL 会把被调函数的返回值写进 RESULT —— 「字符串分支不动 RESULT」
; 必须在 CALL **之前**取快照（SNAP）。
PRINTL INPUTANY：等整数输入（注入 1）
INPUTANY
CALL ASSERT_EQ, RESULT, 1, @"INPUTANY 整数分支 -> RESULT = 1"
NONG += RESULT
PRINTL INPUTANY：等字符串输入（注入 s 任意文本）
; CALL 会把 RESULT 写成被调函数的返回值 —— 先放一个哨兵，验证字符串分支
; 真的「不动 RESULT」（C#：另一者保持原值），而不是恰好等于 0。
RESULT = 12345
INPUTANY
SNAP = RESULT              ; 快照：若字符串分支误写 RESULT，这里就不是哨兵
CALL ASSERT_SEQ, RESULTS, "任意文本", @"INPUTANY 字符串分支 -> RESULTS = 任意文本"
NONG += RESULT
CALL ASSERT_EQ, SNAP, 12345, @"INPUTANY 字符串分支不改 RESULT（哨兵 12345 原样保留）"
NONG += RESULT

;---- FLOWINPUT / FLOWINPUTS（EE：式中函数，恒返回 0）----
CALL ASSERT_EQ, FLOWINPUT(0, 1, 1), 0, @"FLOWINPUT(…) 恒返回 0（只置 Process 选项）"
NONG += RESULT
CALL ASSERT_EQ, FLOWINPUTS(0, ""), 0, @"FLOWINPUTS(…) 恒返回 0"
NONG += RESULT

;---- 带超时：注入没来时超时自动继续（C# InputMouseKey(4,0,0,0,0)）----
; **必须放在最后**：脚本序列耗尽后再等，才能走到超时路径
;（序列里还有待交付的值时，本等待会先吃掉那个值）。
INPUTMOUSEKEY 50
CALL ASSERT_EQ, RESULT:0, 4, @"INPUTMOUSEKEY 超时 RESULT:0 = 4"
NONG += RESULT

;---- TINPUTAWAIT：清单收录的伪名（TINPUT + AWAIT），保持留痕跳过 ----
TINPUTAWAIT
CALL ASSERT_TRUE, 1, @"TINPUTAWAIT（伪名·留痕跳过）执行不报错"
NONG += RESULT
RETURN NONG
