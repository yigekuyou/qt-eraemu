;=============================================================
; [16] 显示行操作（CLEARLINE 族）
;
; 这些命令会删除/清空已显示行 —— 在专用组里执行不影响其它组的输出，
; 因此由手写组覆盖（自动冒烟组里会把组内输出删掉，所以不自动生成）。
;=============================================================
@TEST_DISPLAY
#DIM NONG
#DIM N

PRINTL == 组16：显示行操作（CLEARLINE 族） ==

;---- CLEARLINE：按逻辑行数删（C# deleteLine）----
PRINTL 这一行马上会被 CLEARLINE 删掉
CLEARLINE 1
CALL ASSERT_TRUE, 1, @"CLEARLINE 1 执行不报错"
NONG += RESULT

PRINTL A
PRINTL B
N = LINECOUNT
CLEARLINE 2
CALL ASSERT_EQ, LINECOUNT, N - 2, @"CLEARLINE 2 删掉 2 行"
NONG += RESULT

;---- CLEARTEXTBOX（EE）：清空文本框（留痕桩）----
CLEARTEXTBOX
CALL ASSERT_TRUE, 1, @"CLEARTEXTBOX（EE）执行不报错"
NONG += RESULT

;---- CLEARLINE 边界：非正数不删除，超量请求按 C# 修正 LINECOUNT ----
N = LINECOUNT
CLEARLINE 0
CALL ASSERT_EQ, LINECOUNT, N, @"CLEARLINE 0 不删除且不改变 LINECOUNT"
NONG += RESULT
CLEARLINE -1
CALL ASSERT_EQ, LINECOUNT, N, @"CLEARLINE 负数不删除且不改变 LINECOUNT"
NONG += RESULT
CLEARLINE N + 3
CALL ASSERT_EQ, LINECOUNT, -3, @"CLEARLINE 超量请求按 C# 修正 LINECOUNT"
NONG += RESULT
RETURN NONG
