;=============================================================
; [2] PRINT 全族 · 按钮 · 颜色 · 对齐 · PRINTDATA
;=============================================================
@TEST_PRINT
#DIM NONG
#DIM I
#DIMS S              ;STRDATA 的赋值目标必须是**字符串变量**（eraTW：STRDATA COMMENT:1 / LOCALS）

PRINTL == 组2：PRINT 族 · 按钮 · 颜色 ==

;---- PRINT / PRINTL / PRINTV / PRINTS ----
PRINT 一行不换行文本，
PRINTV 123
PRINTS 456
PRINTL 。（PRINT+PRINTV+PRINTS+PRINTL 拼接）
PRINTL PRINTL 自带换行

;---- PRINTFORM / PRINTFORML / W 后缀省略（W 需要按键，CLI 下只用于交互）----
PRINTFORML 格式串：{1 + 2} 与 %STRLENS("AB")% 与 @(I)
PRINTFORML 转义花括号 {{与}}百分号%%

;---- PRINTC / PRINTLC 定宽（C/LC 本身不换行，需 PRINTL 收行）----
PRINTLC 左对齐：
PRINTL
PRINTC 右对齐：
PRINTL
PRINTFORML PRINTC 定宽 = {PRINTCLENGTH}

;---- 定宽计数函数 ----
CALL ASSERT_EQ, PRINTCLENGTH, 25, @"PRINTCLENGTH 默认 25"
NONG += RESULT

;---- PRINTBUTTON / PRINTBUTTONC / PRINTBUTTONLC（新实现 C/LC）----
PRINTL 按钮演示：
PRINTBUTTON [123] 按钮, 123
PRINTL
PRINTBUTTONC ABC, 456
PRINTL
PRINTBUTTONLC DEF, 789
PRINTL
PRINTBUTTON 字符串值按钮, "STRVAL"
PRINTL

;---- 颜色与样式 ----
SETCOLOR 255,128,0
PRINTL SETCOLOR 橙色
RESETCOLOR
CALL ASSERT_EQ, GETCOLOR, 0xC0C0C0, @"RESETCOLOR 后恢复默认文字色"
NONG += RESULT
SETCOLORBYNAME RED
PRINTL SETCOLORBYNAME RED
RESETCOLOR

;---- SETBGCOLOR / SETBGCOLORBYNAME / RESETBGCOLOR（背景色；C# SETBGCOLOR_Instruction）----
SETBGCOLOR 0, 0, 102
PRINTL SETBGCOLOR 深蓝
SETBGCOLOR 0x336699
PRINTL SETBGCOLOR 0x336699
SETBGCOLORBYNAME C_YELLOW
PRINTL SETBGCOLORBYNAME C_YELLOW
RESETBGCOLOR
PRINTL RESETBGCOLOR 后
CALL ASSERT_TRUE, 1, @"SETBGCOLOR/SETBGCOLORBYNAME/RESETBGCOLOR 不报错"
NONG += RESULT

;---- REDRAW（0=暂停重绘 / 1=恢复）----
REDRAW 0
REDRAW 1
CALL ASSERT_EQ, CURRENTREDRAW(), 1, @"REDRAW 1 后 CURRENTREDRAW 为真"
NONG += RESULT

;---- HTML 系（HTML_PRINT / HTML_TAGSPLIT / 4 个转换函数）----
HTML_PRINT <b>HTML_PRINT 加粗</b><br>
CALL ASSERT_SEQ, HTML_ESCAPE("<a&b>"), "&lt;a&amp;b&gt;", @"HTML_ESCAPE 转义实体"
NONG += RESULT
CALL ASSERT_SEQ, HTML_TOPLAINTEXT("<b>纯文本</b>"), "纯文本", @"HTML_TOPLAINTEXT 剥标签"
NONG += RESULT
CALL ASSERT_TRUE, 1, @"HTML_TAGSPLIT 调用不报错"
NONG += RESULT
HTML_TAGSPLIT <b>标签</b>
CALL ASSERT_TRUE, 1, @"HTML_GETPRINTEDSTR/HTML_POPPRINTINGSTR 可取缓冲"
NONG += RESULT

;---- 对齐 ----
ALIGNMENT CENTER
PRINTL 居中
ALIGNMENT RIGHT
PRINTL 靠右
ALIGNMENT LEFT

;---- DRAWLINE / CUSTOMDRAWLINE ----
DRAWLINE
CUSTOMDRAWLINE --
DRAWLINE

;---- REUSELASTLINE / LINEISEMPTY ----
PRINT 会被 REUSELASTLINE 覆盖的一行
REUSELASTLINE REUSELASTLINE 覆盖了上一行
PRINTL
CALL ASSERT_TRUE, LINEISEMPTY(), @"PRINTL 空行后当前缓冲为空"
NONG += RESULT

;---- PRINTDATA（随机选择一条，只验证能输出）----
PRINTDATA
	DATA 候选甲
	DATAFORM 候选_{1 + 1}
	DATA 候选丙
ENDDATA
PRINTL （PRINTDATA 随机一条）

;---- PRINTDATAL + DATALIST ----
PRINTDATAL
	DATALIST
		DATA 列表项1
		DATA 列表项2
	ENDLIST
	DATA 独立项
ENDDATA
PRINTL （PRINTDATAL）

;---- STRDATA 赋值随机一条 ----
; STRDATA = PRINTDATA 的不显示版：段结构与 PRINTDATA 相同，但**不打印**，
; 把被选中段的文本写进变量。回归：此前 STRDATA 不在宿主名单里 -> 整段被逐行
; 当普通指令执行 -> DATA/ENDDATA 报 [未完成] 且 S 一直是空的。
;CALL 后 S 必须是段里的一条
STRDATAVAR = 0
STRDATA S
	DATA 随机串1
	DATA 随机串2
ENDDATA
SIF S == "随机串1" || S == "随机串2"
	STRDATAVAR = 1
CALL ASSERT_EQ, STRDATAVAR, 1, @"STRDATA 把所选段文本写进变量（不显示）"
PRINTFORML STRDATA -> %S%（随机一条）
PRINTL

;---- SKIPDISP（跳过显示）----
SKIPDISP 1
PRINTL 这一行不应显示
SKIPDISP 0
CALL ASSERT_TRUE, ISSKIP() == 0, @"SKIPDISP 0 后 ISSKIP 为假"
NONG += RESULT

;---- FORML 组合：PUTFORM ----
;PUTFORM 把文本放入 p バッファ（PRINTL 时一起输出）
PUTFORM PUTFORM 内容：
PRINTL 与 PUTFORM 合并输出

;---- DEBUGPRINT 族（调试模式才可见，验证不报错）----
DEBUGPRINTL DEBUGPRINTL（静默）
DEBUGPRINTFORML DEBUG {1 + 1}（静默）

RETURN NONG
