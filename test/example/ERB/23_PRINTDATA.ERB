;=============================================================
; [23] PRINTDATA / DATAFORM / ENDDATA（eraTW TW_TIPS 复现·特征化）
;
; 背景：eraTW 大量使用 PRINTDATA 多段数据块：
;   * SHOP.ERB:230 @TW_TIPS —— 60 条 DATAFORM 的随机提示；
;   * ANOTHER_TALK.ERB 等 —— PRINTDATAL / PRINTDATAW <var>（把选中的
;     下标写回整型变量，如 PRINTDATAW LOCAL:n）。
;
; Emuera 语义（参考仓库内 C# 实现
;   eraTW/パッチ/Emuera1824+.../Emuera/GameProc/Function/Instraction.Child.cs
;   的 PRINT_DATA_Instruction，以及 GameProc/ErbLoader.cs 构建 dataList）：
;   * 每个 DATAFORM 行 = 一个「段」（dataList 的一项；DATALIST 才把多行并一段）；
;   * 执行 PRINTDATA 时随机选一段打印；若带整型变量实参则写入选中下标；
;   * ENDDATA 之后继续执行；PRINTDATAL/…W 额外换行（W 再等一次按键）。
;
; 本组是**特征化测试（characterization test）**：记录当前引擎在运行期
; 「忽略」这三条命令（execution_engine.cpp 的 reportUnfinished 会打印
; [未完成] …在运行期被忽略）。待实现后，把下面两条标注「（特征化）」
; 的断言改成正确语义断言即可（本组其余断言实现前后都成立）。
;=============================================================
@TEST_PRINTDATA
#DIM NONG
#DIM IDX

PRINTL == 组23：PRINTDATA/DATAFORM/ENDDATA（eraTW TW_TIPS 复现） ==

;---- 1) 非空块 + 索引变量：不报错、ENDDATA 之后继续 ----
IDX = -1
RESULTS = "SENTINEL"
PRINTDATA IDX
	DATAFORM TIP_A
	DATAFORM TIP_B
	DATAFORM TIP_C
ENDDATA
CALL ASSERT_TRUE, 1, @"PRINTDATA 段执行不报错"
NONG += RESULT
CALL ASSERT_EQ, IDX, -1, @"（特征化）PRINTDATA 被忽略：索引变量保持 -1"
NONG += RESULT
CALL ASSERT_SEQ, RESULTS, "SENTINEL", @"（特征化）PRINTDATA 被忽略：RESULTS 不被改写"
NONG += RESULT
PRINTL [after-enddata]
CALL ASSERT_TRUE, 1, @"ENDDATA 之后继续执行（不被数据段卡住）"
NONG += RESULT

;---- 2) 空块：也不报错 ----
PRINTDATA
ENDDATA
CALL ASSERT_TRUE, 1, @"空 PRINTDATA 段执行不报错"
NONG += RESULT

;---- 3) 无实参 + PRINTDATAL：不报错 ----
PRINTDATAL
	DATAFORM TIP_X
ENDDATA
CALL ASSERT_TRUE, 1, @"PRINTDATAL（无实参）执行不报错"
NONG += RESULT

RETURN NONG
