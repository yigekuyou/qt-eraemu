;=============================================================
; era 全函数覆盖示例 —— 根目录 test/ 的引擎忠实性回归用例
;
; 运行：build/src/eraengine/test_cli test/example --script 0
;   输入 0 = 自动依次运行全部测试组并打印汇总
;   输入 1..9 = 只运行单组（见菜单）
;=============================================================
@SYSTEM_TITLE
#DIM NONG

$MENU_TOP
DRAWLINE
ALIGNMENT CENTER
PRINTFORML era 全函数覆盖示例（GAMEBASE_TITLE=%GAMEBASE_TITLE%）
PRINTFORML 版本 {GAMEBASE_VERSION} / 作者 %GAMEBASE_AUTHOR%
ALIGNMENT LEFT
DRAWLINE
PRINTL  [0] 全部自动运行
PRINTL  [1] 变量·赋值·数组
PRINTL  [2] PRINT 族·按钮·颜色
PRINTL  [3] 控制流 IF/SELECTCASE/循环/GOTO
PRINTL  [4] 调用 CALL/JUMP/式中函数
PRINTL  [5] TRY*LIST + FUNC/ENDFUNC（新实现）
PRINTL  [6] 字符串函数
PRINTL  [7] 数值函数
PRINTL  [8] CSV/角色函数
PRINTL  [9] 存档 SAVE/LOAD
PRINTL  [10] 全函数覆盖（自动生成）
PRINTL  [11] 输入族·等待（需 test_cli 自动输入）
PRINTL  [12] BEGIN（破坏性·单独跑）
PRINTL  [13] THROW（破坏性·单独跑）
PRINTL  [14] 剩余命令（TRYGOTO/PRINT_RECT/CALLEVENT 等）
PRINTL  [15] 鼠标·原始输入（需 test_cli k 注入）
PRINTL  [16] 显示行操作（CLEARLINE 族）
PRINTL  [17] 环境·桩命令（ASSERT/CALLTRAIN/EE 环境族）
PRINTL  [18] RESTART/EE破坏性（单独跑）
PRINTL  [19] DOTRAIN（预期出错·单独跑）
PRINTL  [20] RESTART 菜单复刻（eraTW NEWGAME_CUSTOM·单独跑）
PRINTL  [21] GOTO 标签作用域（eraTW COMMON_CHOICE·单独跑）
PRINTL  [22] MAP 绘制复现（eraTW DRAW_MAP 逐字符·计时用）
PRINTL  [23] PRINTDATA/DATAFORM/ENDDATA（eraTW TW_TIPS·单独跑）
PRINTL  [24] CSV 名表与 STR 变量（ecd/docs 规范）
PRINTL  [25] RESULTS 下标·#FUNCTIONS 返回值·裸文本赋值（eraTW OPTION 回归）
PRINTL  [26] 自然结束不清 RESULT·裸 RETURNF 空串（eraTW 農家設定选地主回归）
PRINTL  [27] 文档语义·表达式/字面量/声明（ERH 宏/广域/全局/REF/参数初始值）
PRINTL  [28] 文档语义·SELECTCASE/循环/EE 与 eraTW 惯用法
PRINTL  [29] BEGIN FIRST 事件函数流 #PRI/#LATER/#SINGLE/#ONLY（破坏性·单独跑）
PRINTL  [30] 音频·图片（用命令随机生成素材）
PRINTL  [31] GETCONFIG/GETCONFIGS（emuera.config 取值）
PRINTL  [32] 通用图像处理（G/SPRITE/CBG + 真实图像文件 webp）
PRINTL  [33] END 是变量（#DIM END）不是指令
PRINTL  [35] 文档语义冒烟（由 test/data 的 md 生成·需注入输入）
PRINTL  [-1] 退出
DRAWLINE
PRINTL 请输入编号（自动化时输入 0）
ONEINPUT

SELECTCASE RESULT
	CASE 0
		NONG = 0
		CALL TEST_VARIABLE
		NONG += RESULT
		CALL TEST_PRINT
		NONG += RESULT
		CALL TEST_CONTROL
		NONG += RESULT
		CALL TEST_CALL_JUMP
		NONG += RESULT
		CALL TEST_TRYLIST
		NONG += RESULT
		CALL TEST_STRFUNC
		NONG += RESULT
		CALL TEST_NUMFUNC
		NONG += RESULT
		CALL TEST_CSV_CHARA
		NONG += RESULT
		CALL TEST_SAVE
		NONG += RESULT
		CALL TEST_COVERAGE
		NONG += RESULT
		CALL TEST_MISC
		NONG += RESULT
		CALL TEST_DISPLAY
		NONG += RESULT
		CALL TEST_ENV
		NONG += RESULT
		CALL TEST_PRINTDATA
		NONG += RESULT
		CALL TEST_CSV_STR
		NONG += RESULT
		CALL TEST_RESULTS_FN
		NONG += RESULT
		CALL TEST_NOUMIN_RESULT
		NONG += RESULT
		CALL TEST_DOC_EXPR
		NONG += RESULT
		CALL TEST_DOC_FLOW
		NONG += RESULT
		CALL TEST_ASSET_GEN
		NONG += RESULT
		CALL TEST_GETCONFIG
		NONG += RESULT
		CALL TEST_IMAGE
		NONG += RESULT
		CALL TEST_END_VARIABLE
		NONG += RESULT
		; 组35（文档语义冒烟）需注入字符串与鼠标输入，不进自动路径：./test/run_example.sh 35
		CALL TEST_SUMMARY, NONG
		QUIT
	CASE 1
		CALL TEST_VARIABLE
	CASE 2
		CALL TEST_PRINT
	CASE 3
		CALL TEST_CONTROL
	CASE 4
		CALL TEST_CALL_JUMP
	CASE 5
		CALL TEST_TRYLIST
	CASE 6
		CALL TEST_STRFUNC
	CASE 7
		CALL TEST_NUMFUNC
	CASE 8
		CALL TEST_CSV_CHARA
	CASE 9
		CALL TEST_SAVE
	CASE 10
		CALL TEST_COVERAGE
	CASE 11
		CALL TEST_INPUT
	CASE 12
		CALL TEST_BEGIN
	CASE 13
		CALL TEST_THROW
	CASE 14
		CALL TEST_MISC
	CASE 15
		CALL TEST_MOUSE
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 16
		CALL TEST_DISPLAY
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 17
		CALL TEST_ENV
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 18
		CALL TEST_RESTART
		NONG = RESULT
		CALL TEST_DESTRUCTIVE_EE
		NONG += RESULT
		CALL TEST_SUMMARY, NONG
		QUIT
	CASE 19
		CALL TEST_DOTRAIN
	CASE 20
		CALL TEST_RESTART_MENU
	CASE 21
		CALL TEST_GOTO_LABEL_SCOPE
	CASE 22
		CALL TEST_MAP_DRAW
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 23
		CALL TEST_PRINTDATA
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 25
		CALL TEST_RESULTS_FN
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 24
		CALL TEST_CSV_STR
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 26
		CALL TEST_NOUMIN_RESULT
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 27
		CALL TEST_DOC_EXPR
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 28
		CALL TEST_DOC_FLOW
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 29
		CALL TEST_DOC_EVENT
	CASE 30
		CALL TEST_ASSET_GEN
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 31
		CALL TEST_GETCONFIG
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 32
		CALL TEST_IMAGE
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 33
		CALL TEST_END_VARIABLE
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE 35
		CALL TEST_DOC_SMOKE
		CALL TEST_SUMMARY, RESULT
		QUIT
	CASE -1
		QUIT
	CASEELSE
		PRINTL 无效输入
ENDSELECT
;单组运行后回到菜单
GOTO MENU_TOP

;-------------------------------------------------------------
; 汇总
;-------------------------------------------------------------
@TEST_SUMMARY(FAILS)
#DIM FAILS
DRAWLINE
IF FAILS == 0
	SETCOLOR 0,255,0
	PRINTL ★ 全部断言通过（ALL PASS）★
	RESETCOLOR
ELSE
	SETCOLOR 255,0,0
	PRINTFORML ★ 有 {FAILS} 条断言失败（ALL PASS 未达成）★
	RESETCOLOR
ENDIF
DRAWLINE

;-------------------------------------------------------------
; 断言辅助：整数相等 / 字符串相等 / 布尔
; 返回值 = 失败记数（0/1），调用方用 NONG += RESULT 累加
;-------------------------------------------------------------
@ASSERT_EQ(GOT, WANT, SNAME)
#DIMS SNAME
IF GOT == WANT
	DEBUGPRINTL PASS
	RETURN 0
ENDIF
PRINTFORML  [FAIL] %SNAME% : got={GOT} want={WANT}
RETURN 1

@ASSERT_SEQ(GOT, WANT, SNAME)
#DIMS GOT
#DIMS WANT
#DIMS SNAME
IF GOT == WANT
	DEBUGPRINTL PASS
	RETURN 0
ENDIF
PRINTFORML  [FAIL] %SNAME% : got=%GOT% want=%WANT%
RETURN 1

@ASSERT_TRUE(COND, SNAME)
#DIMS SNAME
IF COND
	DEBUGPRINTL PASS
	RETURN 0
ENDIF
PRINTFORML  [FAIL] %SNAME% : 条件不成立
RETURN 1

