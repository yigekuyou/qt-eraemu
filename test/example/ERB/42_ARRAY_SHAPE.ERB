; ===========================================================================
; 组 42 —— 数组形状 VARSIZE（原 src/eraengine/test/test_array_shape.cpp 的
;          ERB 可观察部分迁移；C++ 侧 shapeOf/私有段身份/配置默认值无法从脚本
;          观察，仍留在那个 ctest 里）
;
; 不变量（test_array_shape.cpp 的注释同样写着）：
;   * 形状是**装载期事实**：与是否已写入元素无关，不看容器分配了几个槽；
;   * 多维按声明顺序给出每一维长度，越界维返回 0；
;   * 系统数组（RESULT 等）尺寸来自内置定义，与用户数组同一条问法。
; ===========================================================================
@TEST_ARRAY_SHAPE
#DIM RET
#DIM A1, 7
#DIM A2, 3, 4
#DIM A3, 2, 3, 5
#DIMS S1, 9
RET = 0

;---- 1) 一维 ----
CALL ASSERT_EQ, VARSIZE(A1), 7, "VARSIZE(A1)=7"
CALL ASSERT_EQ, VARSIZE(A1, 0), 7, "VARSIZE(A1,0)=7"
CALL ASSERT_EQ, VARSIZE(A1, 1), 0, "一维数组问第 1 维 = 0（越界）"

;---- 2) 二维：逐维给长度 ----
; 多维数组只能用**字符串**名字形式：裸 A2 在 AST 里是"要带下标的变量引用"，
; VARSIZE(A2, 0) 会报「变量 A2 缺少参数或下标维数错误」（解析期就错）
CALL ASSERT_EQ, VARSIZE("A2", 0), 3, "VARSIZE(\"A2\",0)=3"
CALL ASSERT_EQ, VARSIZE("A2", 1), 4, "VARSIZE(A2,1)=4"
CALL ASSERT_EQ, VARSIZE("A2", 2), 0, "VARSIZE(A2,2)=0（越界）"

;---- 3) 三维 ----
CALL ASSERT_EQ, VARSIZE("A3", 0), 2, "VARSIZE(A3,0)=2"
CALL ASSERT_EQ, VARSIZE("A3", 1), 3, "VARSIZE(A3,1)=3"
CALL ASSERT_EQ, VARSIZE("A3", 2), 5, "VARSIZE(A3,2)=5"
CALL ASSERT_EQ, VARSIZE("A3", 3), 0, "VARSIZE(A3,3)=0（越界）"

;---- 4) 字符串数组同一条问法 ----
CALL ASSERT_EQ, VARSIZE(S1), 9, "VARSIZE(S1)=9"
CALL ASSERT_EQ, VARSIZE(S1, 1), 0, "VARSIZE(S1,1)=0（越界）"

;---- 5) 形状是装载期事实：写过元素不改变它 ----
A1:6 = 123
CALL ASSERT_EQ, VARSIZE(A1), 7, "写入元素后 VARSIZE 不变"
CALL ASSERT_EQ, A1:6, 123, "写入的元素读得回来"

;---- 6) 系统数组与用户数组同一条问法 ----
;      （内置 RESULT 长度 1500；若将来改配置，这条会亮）
CALL ASSERT_EQ, VARSIZE(RESULT), 1500, "VARSIZE(RESULT)=1500（内置定义）"

RETURN RET
