;=============================================================
; [7] 数值函数（文档「算术」组 + 随机数控制）
;=============================================================
@TEST_NUMFUNC
#DIM NONG
#DIM A
#DIM ARR, 8

PRINTL == 组7：数值函数 ==

;---- 绝对值 / 符号 / 平方根 / 乘方 ----
CALL ASSERT_EQ, ABS(-5), 5, @"ABS(-5)"
NONG += RESULT
CALL ASSERT_EQ, ABS(5), 5, @"ABS(5)"
NONG += RESULT
CALL ASSERT_EQ, SIGN(-3), -1, @"SIGN(-3)"
NONG += RESULT
CALL ASSERT_EQ, SIGN(0), 0, @"SIGN(0)"
NONG += RESULT
CALL ASSERT_EQ, SQRT(144), 12, @"SQRT(144)"
NONG += RESULT
CALL ASSERT_EQ, POWER(2, 10), 1024, @"POWER(2,10)"
NONG += RESULT
CALL ASSERT_EQ, POWER(3, 4), 81, @"POWER(3,4)=81"
NONG += RESULT
CALL ASSERT_EQ, EXPONENT(0), 1, @"EXPONENT(0)=e^0=1"
NONG += RESULT

;---- 最值 / 限制 / 区间 ----
CALL ASSERT_EQ, MAX(3, 1, 4, 1, 5), 5, @"MAX 多参数"
NONG += RESULT
CALL ASSERT_EQ, MIN(3, 1, 4, 1, 5), 1, @"MIN 多参数"
NONG += RESULT
CALL ASSERT_EQ, LIMIT(15, 0, 10), 10, @"LIMIT 上界"
NONG += RESULT
CALL ASSERT_EQ, LIMIT(-5, 0, 10), 0, @"LIMIT 下界"
NONG += RESULT
CALL ASSERT_TRUE, INRANGE(5, 1, 10), @"INRANGE 区间内"
NONG += RESULT
CALL ASSERT_TRUE, !INRANGE(50, 1, 10), @"INRANGE 区间外"
NONG += RESULT

;---- 匹配族 ----
;MATCH/CMATCH 第一实参是数组变量（C# VariableTerm），返回命中个数
ARR:0 = 7
ARR:1 = 7
CALL ASSERT_EQ, MATCH(ARR, 7, 0, 8), 2, @"MATCH(ARR, 7) 命中 2 个"
NONG += RESULT
CALL ASSERT_EQ, MATCH(ARR, 5, 0, 8), 0, @"MATCH(ARR, 5) 未命中"
NONG += RESULT
CALL ASSERT_EQ, GROUPMATCH(5, 1, 5, 9), 1, @"GROUPMATCH 计数"
NONG += RESULT
CALL ASSERT_TRUE, ALLSAMES(3, 3, 3), @"ALLSAMES 全同"
NONG += RESULT
CALL ASSERT_TRUE, !NOSAMES(1, 1), @"NOSAMES 有重复为假"
NONG += RESULT

;---- 数组函数 ----
ARR:0 = 5
ARR:1 = 3
ARR:2 = 9
ARR:3 = 1
;数组区间「含首不含尾」（C# for i=index1; i<index2）-> 用 0,4 覆盖四元素
CALL ASSERT_EQ, MAXARRAY(ARR, 0, 4), 9, @"MAXARRAY(ARR,0,4)"
NONG += RESULT
CALL ASSERT_EQ, MINARRAY(ARR, 0, 4), 1, @"MINARRAY(ARR,0,4)"
NONG += RESULT
CALL ASSERT_EQ, SUMARRAY(ARR, 0, 4), 18, @"SUMARRAY(ARR,0,4)"
NONG += RESULT
CALL ASSERT_EQ, FINDELEMENT(ARR, 9, 0, 7), 2, @"FINDELEMENT"
NONG += RESULT
CALL ASSERT_EQ, FINDLASTELEMENT(ARR, 3, 0, 7), 1, @"FINDLASTELEMENT"
NONG += RESULT
;C# 比较是 [min, max)：9 不计入 -> {5,3,1} = 3
CALL ASSERT_EQ, INRANGEARRAY(ARR, 1, 9, 0, 4), 3, @"INRANGEARRAY [1,9) 命中 3 个"
NONG += RESULT
CALL ASSERT_EQ, INRANGEARRAY(ARR, 1, 10, 0, 4), 4, @"INRANGEARRAY [1,10) 命中 4 个"
NONG += RESULT
CALL ASSERT_EQ, VARSIZE("ARR"), 8, @"VARSIZE"
NONG += RESULT

;---- 排序语句 ----
ARRAYSORT ARR, FORWARD, 0, 4
CALL ASSERT_EQ, ARR:0, 1, @"ARRAYSORT 升序首元素"
NONG += RESULT
CALL ASSERT_EQ, ARR:3, 9, @"ARRAYSORT 升序末元素"
NONG += RESULT

;---- 移位 / 删除 ----
VARSET ARR, 0
ARR:0 = 1
ARR:1 = 2
ARR:2 = 3
ARRAYSHIFT ARR, 1, 0, 0, 3
CALL ASSERT_EQ, ARR:1, 1, @"ARRAYSHIFT 后移"
NONG += RESULT
VARSET ARR, 0
ARR:0 = 1
ARR:1 = 2
ARR:2 = 3
ARRAYREMOVE ARR, 1, 1
CALL ASSERT_EQ, ARR:1, 3, @"ARRAYREMOVE 删除下标 1"
NONG += RESULT

;---- 随机数 ----
RANDOMIZE 12345
A = RAND(100)
CALL ASSERT_TRUE, A >= 0 && A < 100, @"RAND(100) 范围"
NONG += RESULT
;同种子 -> 同序列
RANDOMIZE 777
A = RAND(1000)
RANDOMIZE 777
CALL ASSERT_EQ, RAND(1000), A, @"同种子序列可复现"
NONG += RESULT
;DUMPRAND / INITRAND 保存恢复
RANDOMIZE 42
A = RAND(100)
RANDOMIZE 42
DUMPRAND
CALL ASSERT_EQ, RAND(100), A, @"DUMPRAND 后序列一致"
NONG += RESULT
INITRAND
CALL ASSERT_TRUE, RAND(2) >= 0, @"INITRAND 恢复"
NONG += RESULT

RETURN NONG
