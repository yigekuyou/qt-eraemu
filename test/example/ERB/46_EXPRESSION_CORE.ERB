;=============================================================
; 组 46 —— 表达式脚本语义迁移
; 依据：test/data/language/表达式.md、运算符.md、表达式解析边界.md。
; 解析节点、词法 token 和错误阶段检查仍保留在 C++。
;=============================================================
@TEST_EXPRESSION_CORE
#DIM FAILS
#DIM A
#DIM B
#DIM SIDE
#DIM VALUE
#DIMS TEXT

;---- 算术优先级、括号、整数进制和指数记法 ----
CALL ASSERT_EQ, 10 + 20 * 3, 70, "乘法先于加法"
FAILS += RESULT
CALL ASSERT_EQ, (10 + 20) * 3, 90, "括号改变优先级"
FAILS += RESULT
CALL ASSERT_EQ, 0xFF, 255, "十六进制字面量"
FAILS += RESULT
CALL ASSERT_EQ, 0b1010, 10, "二进制字面量"
FAILS += RESULT
CALL ASSERT_EQ, 1e3, 1000, "十进制指数记法"
FAILS += RESULT
CALL ASSERT_EQ, 1p10, 1024, "二进制指数记法"
FAILS += RESULT
CALL ASSERT_EQ, -5 / 3, -1, "整数除法向零截断"
FAILS += RESULT
CALL ASSERT_EQ, -5 % 3, -2, "余数符号跟随被除数"
FAILS += RESULT

;---- 比较、位运算和移位 ----
CALL ASSERT_EQ, 5 > 3, 1, "数值大于比较"
FAILS += RESULT
CALL ASSERT_EQ, 5 == 5, 1, "数值相等比较"
FAILS += RESULT
CALL ASSERT_EQ, 5 != 4, 1, "数值不等比较"
FAILS += RESULT
CALL ASSERT_EQ, 0x0F & 0x03, 3, "按位与"
FAILS += RESULT
CALL ASSERT_EQ, 0x08 | 0x03, 11, "按位或"
FAILS += RESULT
CALL ASSERT_EQ, 0x0F ^ 0x03, 12, "按位异或"
FAILS += RESULT
CALL ASSERT_EQ, 1 << 4, 16, "左移"
FAILS += RESULT
CALL ASSERT_EQ, 16 >> 2, 4, "右移"
FAILS += RESULT
CALL ASSERT_EQ, ~0, -1, "按位取反"
FAILS += RESULT
CALL ASSERT_EQ, !0, 1, "逻辑非"
FAILS += RESULT

;---- 字符串连接、重复和比较 ----
CALL ASSERT_SEQ, "ab" + "cd", "abcd", "字符串连接"
FAILS += RESULT
CALL ASSERT_SEQ, "ab" * 3, "ababab", "字符串乘整数重复"
FAILS += RESULT
CALL ASSERT_SEQ, 3 * "ab", "ababab", "整数乘字符串重复"
FAILS += RESULT
CALL ASSERT_EQ, "b" > "a", 1, "字符串大于比较"
FAILS += RESULT
CALL ASSERT_EQ, "a" == "a", 1, "字符串相等比较"
FAILS += RESULT

;---- 逻辑短路：被跳过的右侧不改变 SIDE ----
SIDE = 0
A = 0 && SIDE++
B = 1 || SIDE++
CALL ASSERT_EQ, SIDE, 0, "&&/|| 短路跳过右侧"
FAILS += RESULT
A = 1 && SIDE++
B = 0 || SIDE++
CALL ASSERT_EQ, SIDE, 2, "&&/|| 需要右侧时只执行一次"
FAILS += RESULT
SIDE = 0
A = 0 !& SIDE++
B = 1 !| SIDE++
CALL ASSERT_EQ, SIDE, 0, "!&/!| 短路跳过右侧"
FAILS += RESULT

;---- 普通三元：分支类型一致，只有选择分支产生值 ----
VALUE = 1 ? 20 # 30
CALL ASSERT_EQ, VALUE, 20, "整数三元真分支"
FAILS += RESULT
VALUE = 0 ? 20 # 30
CALL ASSERT_EQ, VALUE, 30, "整数三元假分支"
FAILS += RESULT
TEXT '= 1 ? "yes" # "no"
CALL ASSERT_SEQ, TEXT, "yes", "字符串三元真分支"
FAILS += RESULT
TEXT '= 0 ? "yes" # "no"
CALL ASSERT_SEQ, TEXT, "no", "字符串三元假分支"
FAILS += RESULT

;---- 复合赋值和前后置自增 ----
VALUE = 5
VALUE += 3
VALUE *= 2
VALUE <<= 1
CALL ASSERT_EQ, VALUE, 32, "复合赋值链"
FAILS += RESULT
A = 5
B = A++
CALL ASSERT_EQ, B, 5, "后置自增返回旧值"
FAILS += RESULT
CALL ASSERT_EQ, A, 6, "后置自增写回新值"
FAILS += RESULT
B = ++A
CALL ASSERT_EQ, B, 7, "前置自增返回新值"
FAILS += RESULT
CALL ASSERT_EQ, A, 7, "前置自增写回新值"
FAILS += RESULT

RETURN FAILS
