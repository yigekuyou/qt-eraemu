;=============================================================
; [22] MAP 绘制（eraTW @DRAW_MAP 逐字符热路径复现·回归 + 计时）
;
; 背景：eraTW 打开地图时 @DRAW_MAP 对地图每一行逐字符：
;     SUBSTRINGU → ISNUMERIC → TRYCALLFORM DRAW_MAP_BG_*
;     → SETCOLOR / PRINTS / RESETCOLOR
; 一张图约 1400 个字符、每字符 6+ 条指令，且有约 40 个 PRINTBUTTON。
; 本组把这条路径**原样**复刻（数据来自 eraTW MAP_00.ERB 神社图，逐字节复制），
; 用途：
;   1) 回归：画 1 张 + 连画 20 张不报错（--check 可查漏按钮/漏色）
;   2) 性能：外部计时，单张耗时突增即回归：
;        time ./test/run_example.sh 22
; 与 eraTW 的差异（不影响热路径指令构成）：
;   * 颜色常量（C_WOOD1 等）→ 字面量；TFLAG:地圖切換 → TFLAG:1
;   * GETMAP 略去居場所察知/KEHAI 分支，保留 SETCOLOR+PRINTBUTTON+RESETCOLOR
;   * 住宿人物（破舊小屋）条件分支略去
;=============================================================
@TEST_MAP_DRAW
#DIM NONG
#DIM I
#DIM LINES_BEFORE
#DIM T0
#DIM T1
#DIM MS

PRINTL == 组22：MAP 绘制（eraTW DRAW_MAP 逐字符复现） ==
TFLAG:1 = 0

;---- 正确性：画一张，行数不小于 23 行地图（eraTW DRAW_MAP 逐行 PRINTL）----
LINES_BEFORE = LINECOUNT
CALL DRAW_MAP_TEST
CALL ASSERT_TRUE, 1, @"DRAW_MAP_TEST 执行不报错"
NONG += RESULT
CALL ASSERT_TRUE, LINECOUNT - LINES_BEFORE >= 23, @"一张图 ≥ 23 行（AA:00..AA:22 逐一 PRINTL）"
NONG += RESULT

;---- 性能复现：连画 20 张自计时（毫秒；突增即性能回归）----
T0 = GETMILLISECOND()
FOR I, 0, 20
	CALL DRAW_MAP_TEST
NEXT
T1 = GETMILLISECOND()
MS = T1 - T0
CALL ASSERT_TRUE, MS >= 0, @"连画 20 张不报错"
NONG += RESULT
PRINTFORML 性能：连画 20 张 = {MS} ms（单张 ≈ {MS / 20} ms）
PRINTFORML 完成：21 张博麗神社图（每张 23 行，逐字符着色）
RETURN NONG

;-----------------------------------------------------------
; Map描画処理（复刻 eraTW DRAW_MAP.ERB 主体）
; 2文字セットの半角数字(01とか)は自動でボタン化、全角数字は認識しない
;-----------------------------------------------------------
@DRAW_MAP_TEST
#DIMS AA, 50
#DIM LINENUM
#DIM X_POINT

VARSET AA
SETFONT "ＭＳ ゴシック"
TRYCALLFORM MAP_TEST_1(AA)

FOR LINENUM, 0, 23
	SIF AA:LINENUM == ""
		CONTINUE
	;行ごとに初期化
	X_POINT = 0
	RESULTS = "X"
	;行の終端までループ
	WHILE RESULTS != "" && STRLENSU(RESULTS) < 3
		;1文字取り出す
		SUBSTRINGU AA:LINENUM, X_POINT, 1
		;数字ならボタンにする
		IF ISNUMERIC(RESULTS)
			;分岐めんどいから必ず2ケタ取る
			SUBSTRINGU AA:LINENUM, X_POINT, 2
			CALL GETMAP_TEST(TOINT(RESULTS))
			X_POINT += 2
		;記号に意味を持たせる例、これだと#は普通には使えなくなるけどまあいいか
		ELSEIF RESULTS == "#"
			;必ず二文字取る
			SUBSTRINGU AA:LINENUM, X_POINT, 2
			TRYCALLFORM DRAW_MAP_BG_TEST(RESULTS)
			X_POINT += 2
		;ふつうの文字
		ELSE
			TRYCALLFORM DRAW_MAP_BG_TEST(RESULTS)
			X_POINT ++
		ENDIF
	WEND
	PRINTL
NEXT
SETFONT
RESETCOLOR

