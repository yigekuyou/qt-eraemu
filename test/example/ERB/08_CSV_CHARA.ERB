;=============================================================
; [8] CSV / 角色函数 + 角色操作命令
;=============================================================
@TEST_CSV_CHARA
#DIM NONG
#DIM I

PRINTL == 组8：CSV/角色函数 ==

;---- CSV 模板读取（CSV/Chara/Chara0.csv + CSV/ABL.csv）----
CALL ASSERT_TRUE, EXISTCSV(0), @"EXISTCSV(0)"
NONG += RESULT
CALL ASSERT_SEQ, CSVNAME(0), "测试者", @"CSVNAME(0)"
NONG += RESULT
CALL ASSERT_SEQ, CSVCALLNAME(0), "测试", @"CSVCALLNAME(0)"
NONG += RESULT
CALL ASSERT_EQ, CSVBASE(0, 0), 1000, @"CSVBASE(0, 体力)"
NONG += RESULT
CALL ASSERT_EQ, CSVABL(0, 2), 3, @"CSVABL(0, 技巧)"
NONG += RESULT

;---- 名称表（ABLNAME 来自 CSV/ABL.csv）----
CALL ASSERT_SEQ, ABLNAME:0, "体力", @"ABLNAME:0"
NONG += RESULT

;---- 角色操作 ----
DELALLCHARA
CALL ASSERT_EQ, CHARANUM, 0, @"DELALLCHARA 后 CHARANUM=0"
NONG += RESULT
ADDCHARA 0
CALL ASSERT_EQ, CHARANUM, 1, @"ADDCHARA 0"
NONG += RESULT
ADDVOIDCHARA
CALL ASSERT_EQ, CHARANUM, 2, @"ADDVOIDCHARA"
NONG += RESULT
CALL ASSERT_SEQ, NAME:1, "", @"VOID 角色 NAME 为空"
NONG += RESULT
ADDCHARA 0
CALL ASSERT_EQ, CHARANUM, 3, @"再次 ADDCHARA 0"
NONG += RESULT
CALL ASSERT_SEQ, NAME:2, "测试者", @"NAME:2 来自 CSV"
NONG += RESULT

;---- SWAPCHARA / COPYCHARA / ADDCOPYCHARA ----
SWAPCHARA 0, 2
CALL ASSERT_SEQ, NAME:0, "测试者", @"SWAPCHARA 后 NAME:0"
NONG += RESULT
COPYCHARA 0, 2
CALL ASSERT_SEQ, NAME:2, "测试者", @"COPYCHARA 复制"
NONG += RESULT
ADDCOPYCHARA 0
CALL ASSERT_EQ, CHARANUM, 4, @"ADDCOPYCHARA 追加副本"
NONG += RESULT

;---- FINDCHARA / GETCHARA ----
CALL ASSERT_EQ, FINDCHARA(NO, 0), 0, @"FINDCHARA(NO, 0) 首个 NO=0 的角色"
NONG += RESULT
CALL ASSERT_EQ, FINDLASTCHARA(NO, 0), 3, @"FINDLASTCHARA(NO, 0) 最后一个"
NONG += RESULT
CALL ASSERT_TRUE, GETCHARA(0) >= 0, @"GETCHARA(0) 找到"
NONG += RESULT

;---- ARRAYMSORT / PICKUPCHARA（角色列表重排；之后复原列表，避免影响后续断言）----
;先构造 3 个同模板角色并写入不同的可比较值
DELALLCHARA
ADDCHARA 0
ADDCHARA 0
ADDCHARA 0
CFLAG:0:1 = 30
CFLAG:1:1 = 10
CFLAG:2:1 = 20
ARRAYMSORT CFLAG:1, FORWARD
CALL ASSERT_EQ, CHARANUM, 3, @"ARRAYMSORT 不改变角色数量"
NONG += RESULT
PICKUPCHARA 0, 1
CALL ASSERT_EQ, CHARANUM, 2, @"PICKUPCHARA 只保留指定角色"
NONG += RESULT
;复原为 4 个干净角色（供后续断言使用）
DELALLCHARA
ADDCHARA 0
ADDCHARA 0
ADDCHARA 0
ADDCHARA 0
CALL ASSERT_EQ, CHARANUM, 4, @"复原角色数量"
NONG += RESULT

;---- SORTCHARA（按 NO 升序；同模板角色顺序不变、数量不变）----
SORTCHARA NO
CALL ASSERT_EQ, CHARANUM, 4, @"SORTCHARA 后角色数量不变"
NONG += RESULT
CALL ASSERT_SEQ, NAME:0, "测试者", @"SORTCHARA 后首角色仍为模板 0"
NONG += RESULT
SORTCHARA NO, BACK
CALL ASSERT_EQ, CHARANUM, 4, @"SORTCHARA BACK 后角色数量不变"
NONG += RESULT

;---- UPCHECK（全局 UP/DOWN 应用到 TARGET 的 PALAM 后清零）----
TARGET = 0
PALAM:0:0 = 0
UP:0 = 30
DOWN:0 = 10
UPCHECK
CALL ASSERT_EQ, PALAM:0:0, 20, @"UPCHECK 应用 UP/DOWN（30-10）到 PALAM"
NONG += RESULT
CALL ASSERT_TRUE, UP:0 == 0 && DOWN:0 == 0, @"UPCHECK 结束后 UP/DOWN 清零"
NONG += RESULT
UP:0 = 5
UPCHECK
CALL ASSERT_EQ, PALAM:0:0, 25, @"UPCHECK 第二次累加"
NONG += RESULT

;---- 状态打印族（PRINT_ABL/PRINT_PALAM/PRINT_ITEM/PRINT_SHOPITEM 冒烟）----
PRINT_ABL 0
PRINT_PALAM 0
PRINT_ITEM
PRINT_SHOPITEM
CALL ASSERT_TRUE, 1, @"PRINT_ABL/PRINT_PALAM/PRINT_ITEM/PRINT_SHOPITEM 执行不报错"
NONG += RESULT

;---- 角色变量运行时读写 ----
CFLAG:0:0 = 77
CALL ASSERT_EQ, CFLAG:0:0, 77, @"CFLAG 运行时写入"
NONG += RESULT
CVARSET CFLAG, 0, 5
CALL ASSERT_EQ, CFLAG:2:0, 5, @"CVARSET 全角色"
NONG += RESULT

;---- GETNUM（由名称取编号）----
CALL ASSERT_EQ, GETNUM(ABL, "技巧"), 2, @"GETNUM(ABL, 技巧)"
NONG += RESULT

;---- GETPALAMLV / GETEXPLV（阈值表 PALAMLV:1..N）----
PALAMLV:1 = 1000
PALAMLV:2 = 2000
PALAMLV:3 = 3000
CALL ASSERT_EQ, GETPALAMLV(1500, 3), 1, @"GETPALAMLV(1500,3)：1500>=1000 且 <2000"
NONG += RESULT
CALL ASSERT_EQ, GETPALAMLV(5000, 3), 3, @"GETPALAMLV(5000,3)：超过所有阈值 -> maxlv"
NONG += RESULT

;---- DELCHARA ----
DELCHARA 1
CALL ASSERT_EQ, CHARANUM, 3, @"DELCHARA 后数量"
NONG += RESULT

;---- RESETDATA / RESET_STAIN（冒烟）----
RESETDATA
CALL ASSERT_EQ, CHARANUM, 0, @"RESETDATA 清空角色"
NONG += RESULT

RETURN NONG
