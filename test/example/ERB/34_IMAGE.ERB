;************************************************************************
; 组 34：真实图像文件（webp）× eraTW 式精灵堆叠与精灵序列
;
; 调查来源（三处的图像用法各有侧重，本组各取其型）：
;   * eraTW  ERB\リソース作成.ERB / グラフィック表示ライブラリ\グラフィック合成.ERB：
;       「底片 + 部件精灵逐层叠进一张 G（GDRAWSPRITE 带 CSV 偏移）
;         -> SPRITECREATE 合成精灵 -> 再当素材叠下一层」的立绘/特效流水线；
;       CN_GRAPHIC：GDRAWSPRITE 第 7 实参传カラーマトリクス（颜色矩阵）出特效；
;       映姫（30.csv）：同名资源多行注册成**精灵图序列**（帧矩形+延时逐行给出），
;       运行期等价物是 SPRITEANIMECREATE/SPRITEANIMEADDFRAME + SETANIMETIMER。
;   * Emuera C#  Content/AppContents.cs：resources/*.csv 的 ANIME 声明与帧行、
;       SpriteAnime（同名多行 = 帧追加）是上述序列的本源语义。
;   * ecd/docs  translation/Resource.html：资源名→文件解析（扩展名可省，
;       png/jpg/bmp/webp/gif 逐个尝试）、delay 列（第 9 列）= 帧显示时间。
;
; 素材（resources/，来源声明见 README_webp.md）：
;   * webp_atlas.webp / webp_item.webp：ImageMagick 造的 lossless webp，
;     解码逐像素精确 -> GGETCOLOR 可做**精确**断言；
;   * isotile_lossy.webp（2048×2048 VP8X 有损）、anim_add_lossy.webp
;     （1408×1536 裸 VP8 有损、帧图集）、anim_alpha_animated_lossy.webp
;     （128×128 VP8X **动画**）——来自 ImagicTheCat gist 的真实文件，
;     只断言「能解码出正确尺寸 + 像素采样有效」，不比色（有损无精确值）。
;
; 断言覆盖：
;   1) GCREATEFROMFILE 从真实 webp 文件建 G（lossless 精确比色 + 有损尺寸）
;   2) 静态资源按**裸名**解析（扩展名省略，SPRITECREATED/SPRITEWIDTH）
;   3) eraTW 式堆叠：底片 + 两个带偏移部件 + 中心差分 -> 像素级验证落点
;      （6 参 GDRAWSPRITE 的落点 = 目标原点 + CSV 偏移缩放，组 32 的延续）
;   4) SPRITECREATE 合成精灵 -> 二次合成（合成精灵当素材再画）
;   5) 颜色矩阵特效：GDRAWSPRITE 7 参，R→G 通道交换（红画成绿）
;   6) GDRAWG 源矩形拷贝 / GDRAWGWITHMASK 掩码合成（掩码 alpha=0 处保底）
;   7) GSAVE/GLOAD 落盘往返（sav/imgNNNN.png）
;   8) 精灵图序列：SPRITEANIMECREATE/SPRITEANIMEADDFRAME（多帧堆叠合成图）
;      + SETANIMETIMER（渲染层暂未消费，接受即 0——本组只在数据层断言）
;   9) HTML_PRINT <img> 展示（合成精灵 / 裸名 / 带扩展名 / 动画 webp），
;      供 GUI 帧抓取（run_gui_frames.sh）做 QML 图像功能的截图检查
;************************************************************************

@TEST_IMAGE_FILE
#DIM FAILS
#DIM GID
#DIM G2
#DIM G3
#DIM G4
#DIM G5
#DIM G6
#DIM G7
#DIM GSRC
#DIM GMASK
#DIM GF1
#DIM GF2
#DIM GF3
FAILS = 0
DRAWLINE
PRINTL == 组34：真实图像文件（webp）× 精灵堆叠 × 精灵序列 ==
DRAWLINE

;--- 1) GCREATEFROMFILE：lossless webp 精确比色 -------------------------
;webp_atlas.webp 16×16 四象限（左上红/右上蓝/左下绿/右下黄）
GID = 3400
CALL ASSERT_EQ, GCREATEFROMFILE(GID, "webp_atlas.webp"), 1, @"GCREATEFROMFILE(lossless webp)"
FAILS += RESULT
CALL ASSERT_EQ, GCREATED(GID), 1, @"GCREATED"
FAILS += RESULT
CALL ASSERT_EQ, GWIDTH(GID), 16, @"GWIDTH = 16"
FAILS += RESULT
CALL ASSERT_EQ, GHEIGHT(GID), 16, @"GHEIGHT = 16"
FAILS += RESULT
;lossless：解码后逐像素精确（若 Qt 解码失败会走「全透明回退」，这里必须是不透明实色）
CALL ASSERT_EQ, GGETCOLOR(GID, 0, 0), 4294901760, @"左上 = 红 0xFFFF0000（lossless 精确）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GID, 15, 0), 4278190335, @"右上 = 蓝"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GID, 0, 15), 4278255360, @"左下 = 绿"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GID, 15, 15), 4294967040, @"右下 = 黄"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GID, 16, 0), -1, @"GGETCOLOR 越界 = -1"
FAILS += RESULT

;--- 2) 静态资源按裸名解析（扩展名省略；ecd/docs Resource.html 语义）----
CALL ASSERT_EQ, SPRITECREATED("webp_atlas"), 1, @"裸名（无扩展名）也能解析到 webp"
FAILS += RESULT
CALL ASSERT_EQ, SPRITECREATED("webp_atlas.webp"), 1, @"带扩展名同样解析到"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEWIDTH("webp_atlas"), 16, @"SPRITEWIDTH(裸名) = 16"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEHEIGHT("webp_atlas"), 16, @"SPRITEHEIGHT(裸名) = 16"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEGETCOLOR("webp_atlas", 0, 0), 4294901760, @"SPRITEGETCOLOR 经 CSV 精灵 = 红"
FAILS += RESULT

;--- 3) eraTW 式堆叠：底片 + 带偏移部件 + 中心差分 ----------------------
;（リソース作成.ERB @COMPOSE_SPRITE / モブ子表示.ERB 的流水线）
G2 = 3401
CALL ASSERT_EQ, GCREATE(G2, 16, 16), 1, @"合成画布 16×16"
FAILS += RESULT
;底片：整张图集铺满
CALL ASSERT_EQ, GDRAWSPRITE(G2, "webp_base", 0, 0, 16, 16), 1, @"底片铺满"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 4, 4), 4294901760, @"底片左上 = 红"
FAILS += RESULT
;部件1：红 8×8，CSV 偏移 (2,0) -> 画到 (8,8) 时落点右移 2 = (10,8)
CALL ASSERT_EQ, GDRAWSPRITE(G2, "webp_red", 8, 8, 8, 8), 1, @"部件1（红，偏移(2,0)）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 12, 12), 4294901760, @"偏移落点 (12,12) = 红（右下黄被盖）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 8, 9), 4294967040, @"偏移未盖到处 (8,9) = 黄（落点没错到 (8,8)）"
FAILS += RESULT
;部件2：蓝 8×8，CSV 偏移 (0,1) -> 画到 (0,8) 时落点下移 1 = (0,9)
CALL ASSERT_EQ, GDRAWSPRITE(G2, "webp_blue", 0, 8, 8, 8), 1, @"部件2（蓝，偏移(0,1)）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 4, 12), 4278190335, @"偏移落点 (4,12) = 蓝（左下绿被盖）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 4, 8), 4278255360, @"偏移未盖到 (4,8) = 绿"
FAILS += RESULT
;差分（特效）：品红 4×4 压中心
;（先证明 webp_item.webp 是**真解码**——若 Qt 解码失败会走全透明回退，SPRITEGETCOLOR 得 0）
CALL ASSERT_EQ, SPRITEGETCOLOR("webp_diff", 0, 0), 4294902015, @"webp_item.webp 真解码（非透明回退）"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(G2, "webp_diff", 6, 6, 4, 4), 1, @"差分压中心 (6,6)"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 6, 6), 4294902015, @"差分内 (6,6) = 品红"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 9, 9), 4286578943, @"差分内 (9,9) = 紫 0xFF8000FF"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G2, 5, 5), 4294901760, @"差分外 (5,5) 仍 = 红"
FAILS += RESULT

;--- 4) SPRITECREATE 合成精灵 -> 二次合成 -------------------------------
CALL ASSERT_EQ, SPRITECREATE("webp_stack", G2), 1, @"SPRITECREATE(堆叠合成图)"
FAILS += RESULT
CALL ASSERT_EQ, SPRITECREATED("webp_stack"), 1, @"SPRITECREATED"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEWIDTH("webp_stack"), 16, @"合成精灵宽 = 16"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEGETCOLOR("webp_stack", 12, 12), 4294901760, @"合成精灵 (12,12) = 红"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEGETCOLOR("webp_stack", 9, 9), 4286578943, @"合成精灵 (9,9) = 紫"
FAILS += RESULT
;二次合成：合成精灵当素材再画进新 G（eraTW 立绘合成→再合成 同型）
G3 = 3402
CALL ASSERT_EQ, GCREATE(G3, 16, 16), 1, @"二次合成画布"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(G3, "webp_stack"), 1, @"2 参 GDRAWSPRITE（按精灵自身尺寸铺）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G3, 12, 12), 4294901760, @"二次合成 (12,12) = 红"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G3, 9, 9), 4286578943, @"二次合成 (9,9) = 紫"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEDISPOSE("webp_stack"), 1, @"SPRITEDISPOSE"
FAILS += RESULT
CALL ASSERT_EQ, SPRITECREATED("webp_stack"), 0, @"dispose 后不存在"
FAILS += RESULT

;--- 5) 颜色矩阵特效：GDRAWSPRITE 7 参，R→G 通道交换 --------------------
;（CN_GRAPHIC/Main.ERB：GDRAWSPRITE …, CN_DEFAULT_CM:COLORINT:0:0）
;矩阵行 = 输出通道：R 行全 0，G 行 = (256,0,0,0,0)（G'=R），A 行 = 单位 -> 红(255,0,0)画成绿(0,255,0)
VARSET WEBP_CM, 0
WEBP_CM:1:0 = 256
WEBP_CM:3:3 = 256
CALL ASSERT_EQ, WEBP_CM:1:0, 256, @"探针:WEBP_CM:1:0 = 256"
FAILS += RESULT
CALL ASSERT_EQ, WEBP_CM:3:3, 256, @"探针:WEBP_CM:3:3 = 256"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(G3, "webp_red", 0, 0, 8, 8, WEBP_CM:0:0), 1, @"GDRAWSPRITE 7参（颜色矩阵）"
FAILS += RESULT
;webp_red 带 CSV 偏移 (2,0) -> 画到 (0,0,8,8) 的实际落点是 (2,0)
CALL ASSERT_EQ, GGETCOLOR(G3, 2, 0), 4278255360, @"红被矩阵画成绿（R→G 交换，落点含偏移）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G3, 0, 0), 4294901760, @"偏移外 (0,0) = 上一层的红不变"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G3, 4, 12), 4278190335, @"矩阵只作用于本次绘制：(4,12) 的蓝不变"
FAILS += RESULT

;--- 6) GDRAWG 源矩形拷贝 / GDRAWGWITHMASK 掩码合成 ---------------------
GSRC = 3403
CALL ASSERT_EQ, GCREATE(GSRC, 8, 8), 1, @"源 G 8×8"
FAILS += RESULT
CALL ASSERT_EQ, GCLEAR(GSRC, 4278255615), 1, @"源 G 涂青"
FAILS += RESULT
G4 = 3404
CALL ASSERT_EQ, GCREATE(G4, 16, 16), 1, @"目标 G 16×16"
FAILS += RESULT
CALL ASSERT_EQ, GCLEAR(G4, 0), 1, @"目标 G 清成全透明"
FAILS += RESULT
;GDRAWG id, srcId, destX,destY,destW,destH, srcX,srcY,srcW,srcH
CALL ASSERT_EQ, GDRAWG(G4, GSRC, 0, 0, 4, 4, 2, 2, 4, 4), 1, @"GDRAWG 源矩形(2,2,4,4)->目标(0,0,4,4)"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G4, 0, 0), 4278255615, @"拷贝落点 (0,0) = 青"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G4, 3, 3), 4278255615, @"拷贝内 (3,3) = 青"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G4, 4, 4), 0, @"拷贝外 (4,4) 透明"
FAILS += RESULT
;掩码：8×8 全透明 + 左上 4×4 不透明白 -> 只在掩码不透明处用源图覆盖
GMASK = 3405
CALL ASSERT_EQ, GCREATE(GMASK, 8, 8), 1, @"掩码 G 8×8"
FAILS += RESULT
CALL ASSERT_EQ, GCLEAR(GMASK, 0), 1, @"掩码全透明"
FAILS += RESULT
CALL ASSERT_EQ, GSETBRUSH(GMASK, 4294967295), 1, @"掩码画刷白"
FAILS += RESULT
CALL ASSERT_EQ, GFILLRECTANGLE(GMASK, 0, 0, 4, 4), 1, @"掩码左上 4×4 不透明"
FAILS += RESULT
G6 = 3406
CALL ASSERT_EQ, GCREATE(G6, 8, 8), 1, @"掩码目标 G 8×8"
FAILS += RESULT
CALL ASSERT_EQ, GCLEAR(G6, 4278190080), 1, @"掩码目标涂黑（不透明）"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWGWITHMASK(G6, GSRC, GMASK, 0, 0), 1, @"GDRAWGWITHMASK"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G6, 0, 0), 4278255615, @"掩码不透明处 = 源的青"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G6, 6, 6), 4278190080, @"掩码透明处 = 保留底的黑"
FAILS += RESULT

;--- 7) GSAVE/GLOAD 落盘往返 -------------------------------------------
CALL ASSERT_EQ, GSAVE(GSRC, 3400), 1, @"GSAVE -> sav/img3400.png"
FAILS += RESULT
G7 = 3407
CALL ASSERT_EQ, GLOAD(G7, 3400), 1, @"GLOAD 到新 ID"
FAILS += RESULT
CALL ASSERT_EQ, GWIDTH(G7), 8, @"往返后宽 = 8"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(G7, 0, 0), 4278255615, @"往返后 (0,0) = 青"
FAILS += RESULT

;--- 8) 精灵图序列（eraTW 映姫 30.csv 同名多行 = 帧；运行期 SPRITEANIME 系）----
;三帧 = 三张堆叠合成图：底片 -> 底片+部件 -> 底片+部件+差分（eraTW 差分轮播同型）
GF1 = 3410
CALL ASSERT_EQ, GCREATE(GF1, 16, 16), 1, @"序列帧1画布"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(GF1, "webp_base", 0, 0, 16, 16), 1, @"帧1 = 底片"
FAILS += RESULT
GF2 = 3411
CALL ASSERT_EQ, GCREATE(GF2, 16, 16), 1, @"序列帧2画布"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(GF2, "webp_base", 0, 0, 16, 16), 1, @"帧2 = 底片"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(GF2, "webp_red", 8, 8, 8, 8), 1, @"帧2 += 部件(红)"
FAILS += RESULT
GF3 = 3412
CALL ASSERT_EQ, GCREATE(GF3, 16, 16), 1, @"序列帧3画布"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWG(GF3, GF2, 0, 0, 16, 16, 0, 0, 16, 16), 1, @"帧3 = 帧2 全图拷贝"
FAILS += RESULT
CALL ASSERT_EQ, GDRAWSPRITE(GF3, "webp_diff", 6, 6, 4, 4), 1, @"帧3 += 差分(品红)"
FAILS += RESULT
;帧内容先逐像素验证，再进序列
CALL ASSERT_EQ, GGETCOLOR(GF1, 12, 12), 4294967040, @"帧1 (12,12) = 黄（无部件）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GF2, 12, 12), 4294901760, @"帧2 (12,12) = 红（部件已叠）"
FAILS += RESULT
CALL ASSERT_EQ, GGETCOLOR(GF3, 9, 9), 4286578943, @"帧3 (9,9) = 紫（差分已压）"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEANIMECREATE("webp_seq", 16, 16), 1, @"SPRITEANIMECREATE(序列声明)"
FAILS += RESULT
;延时取 eraTW 30.csv 的帧时间形态（首帧长驻 4500ms，后续 60/50ms）
CALL ASSERT_EQ, SPRITEANIMEADDFRAME("webp_seq", GF1, 0, 0, 16, 16, 0, 0, 4500), 1, @"序列帧1（延时4500）"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEANIMEADDFRAME("webp_seq", GF2, 0, 0, 16, 16, 0, 0, 60), 1, @"序列帧2（延时60）"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEANIMEADDFRAME("webp_seq", GF3, 0, 0, 16, 16, 0, 0, 50), 1, @"序列帧3（延时50）"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEANIMEADDFRAME("no_such_seq", GF1, 0, 0, 16, 16, 0, 0, 60), 0, @"未声明的序列加帧 = 0"
FAILS += RESULT
CALL ASSERT_EQ, SPRITEANIMECREATE("bad_seq", 0, 16), 0, @"尺寸 0 的序列声明 = 0"
FAILS += RESULT
CALL ASSERT_EQ, SETANIMETIMER(55), 0, @"SETANIMETIMER 接受（渲染层暂未消费）"
FAILS += RESULT

;--- 9) 真实 webp（gist 文件）：有损 / 裸 VP8 / 动画 --------------------
;只断言「能解码出正确尺寸 + 像素采样有效」，不比色（有损无精确期望值）
G5 = 3408
CALL ASSERT_EQ, GCREATEFROMFILE(G5, "isotile_lossy.webp"), 1, @"GCREATEFROMFILE(VP8X 有损 2048²)"
FAILS += RESULT
CALL ASSERT_EQ, GWIDTH(G5), 2048, @"isotile 宽 = 2048"
FAILS += RESULT
CALL ASSERT_EQ, GHEIGHT(G5), 2048, @"isotile 高 = 2048"
FAILS += RESULT
CALL ASSERT_TRUE, GGETCOLOR(G5, 0, 0) >= 0, @"isotile 像素采样有效"
FAILS += RESULT
CALL ASSERT_EQ, GDISPOSE(G5), 1, @"GDISPOSE(isotile)"
FAILS += RESULT
CALL ASSERT_EQ, GCREATEFROMFILE(G5, "anim_add_lossy.webp"), 1, @"GCREATEFROMFILE(裸 VP8 有损帧图集)"
FAILS += RESULT
CALL ASSERT_EQ, GWIDTH(G5), 1408, @"anim_add 宽 = 1408（11×128）"
FAILS += RESULT
CALL ASSERT_EQ, GHEIGHT(G5), 1536, @"anim_add 高 = 1536（12×128）"
FAILS += RESULT
CALL ASSERT_TRUE, GGETCOLOR(G5, 100, 100) >= 0, @"anim_add 像素采样有效"
FAILS += RESULT
CALL ASSERT_EQ, GDISPOSE(G5), 1, @"GDISPOSE(anim_add)"
FAILS += RESULT
;动画 webp：QImage 读首帧，尺寸必须是 128×128
CALL ASSERT_EQ, GCREATEFROMFILE(G5, "anim_alpha_animated_lossy.webp"), 1, @"GCREATEFROMFILE(VP8X 动画)"
FAILS += RESULT
CALL ASSERT_EQ, GWIDTH(G5), 128, @"动画 webp 宽 = 128（首帧）"
FAILS += RESULT
CALL ASSERT_EQ, GHEIGHT(G5), 128, @"动画 webp 高 = 128（首帧）"
FAILS += RESULT
CALL ASSERT_TRUE, GGETCOLOR(G5, 64, 64) >= 0, @"动画 webp 首帧像素采样有效"
FAILS += RESULT
CALL ASSERT_EQ, GDISPOSE(G5), 1, @"GDISPOSE(动画)"
FAILS += RESULT

;--- 10) HTML_PRINT <img> 展示（QML 图像功能的截图检查素材）-------------
;eraTW グラフィック表示.ERB 的 <img src=… width=… height=…> 生成式同型。
;width/height 是**字号百分比**（C# ConsoleImagePart：height = FontSize*raw/100，
;800 = 8 倍字号 ≈ 144px），不带 width/height 时按资源**固有像素**排版。
;展示精灵**不销毁**：QML 异步取图（Qt 文档 QQuickImageProvider：QImage 型
;provider 走低优先级线程）晚于本函数结束，销毁会让 <img> 退化成 AltText
;（eraTW 立绘精灵也是常驻的）。
PRINTL ---- HTML_PRINT 展示（webp 图像渲染） ----
;两张一行（800% 字号 ≈ 144px）：左 = 堆叠合成精灵，右 = 原始图集文件。
;对比可见堆叠效果：合成图右下被红部件盖住、左下被蓝部件下移盖住、中心压了品红/紫差分。
CALL ASSERT_EQ, SPRITECREATE("webp_stack2", G2), 1, @"SPRITECREATE(展示用合成精灵)"
FAILS += RESULT
HTML_PRINT @"<img src='webp_stack2' width='800' height='800'><img src='webp_atlas.webp' width='800' height='800'>"
;图像跨 8 行（800% 字号），先占住行再打下一组，否则后打印的图会叠在上面
;（对齐 C# 逐 part 顺序绘制：后打印者盖先打印者）
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
;裸名（扩展名省略）与真实动画 webp（Qt 解首帧）。
;注：该动画共 117 帧、首帧**全透明**（alpha 渐显动画），<img> 显示为空块是
;内容使然而非解码失败（QImage::load 成功解出 128×128 ARGB32，见组内断言）
HTML_PRINT @"<img src='webp_atlas' width='800' height='800'><img src='anim_alpha_animated_lossy.webp' width='800' height='800'>"
;占住图像跨的行，避免后续文字叠在图上
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
PRINTL
HTML_PRINT @"<p align='left'><img src='webp_base' width='400' height='400'> eraTW 式 img 行：src/width/height 生成</p>"

;--- 清理（webp_stack2 展示精灵常驻，见上） ------------------------------
