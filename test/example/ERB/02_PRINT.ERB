;=============================================================
; [2] PRINT 全族 · 按钮 · 颜色 · 对齐 · PRINTDATA
;=============================================================
@TEST_PRINT
#DIM NONG
#DIM I
#DIMS S              ;STRDATA 的赋值目标必须是**字符串变量**（eraTW：STRDATA COMMENT:1 / LOCALS）
#DIMS FORM_EQ        ;%…% 里含「字符串变量运算」的回归（见下方）

PRINTL == 组2：PRINT 族 · 按钮 · 颜色 ==

;---- PRINT / PRINTL / PRINTV / PRINTS ----
PRINT 一行不换行文本，
PRINTV 123
PRINTS 456
PRINTL 。（PRINT+PRINTV+PRINTS+PRINTL 拼接）
PRINTL PRINTL 自带换行

;---- PRINTFORM / PRINTFORML / W 后缀省略（W 需要按键，CLI 下只用于交互）----
PRINTFORML 格式串：{1 + 2} 与 {STRLENS("AB")} 与 @(I)
PRINTFORML 转义花括号 \{与\}百分号\%

;---- PRINTC / PRINTLC 定宽（C/LC 本身不换行，需 PRINTL 收行）----
PRINTLC 左对齐：
PRINTL
PRINTC 右对齐：
PRINTL
PRINTFORML PRINTC 定宽 = {PRINTCLENGTH}

;---- 定宽计数函数 ----
CALL ASSERT_EQ, PRINTCLENGTH, 25, @"PRINTCLENGTH 默认 25"
NONG += RESULT

;---- PRINTBUTTON / PRINTBUTTONC / PRINTBUTTONLC（新实现 C/LC）----
PRINTL 按钮演示：
PRINTBUTTON "[123] 按钮", 123
PRINTL
PRINTBUTTONC "ABC", 456
PRINTL
PRINTBUTTONLC "DEF", 789
PRINTL
PRINTBUTTON "字符串值按钮", "STRVAL"
PRINTL

;---- 颜色与样式 ----
SETCOLOR 255,128,0
PRINTL SETCOLOR 橙色
RESETCOLOR
CALL ASSERT_EQ, GETCOLOR, 0xC0C0C0, @"RESETCOLOR 后恢复默认文字色"
NONG += RESULT
SETCOLORBYNAME RED
PRINTL SETCOLORBYNAME RED
RESETCOLOR

;---- SETBGCOLOR / SETBGCOLORBYNAME / RESETBGCOLOR（背景色；C# SETBGCOLOR_Instruction）----
SETBGCOLOR 0, 0, 102
PRINTL SETBGCOLOR 深蓝
SETBGCOLOR 0x336699
PRINTL SETBGCOLOR 0x336699
SETBGCOLORBYNAME C_YELLOW
PRINTL SETBGCOLORBYNAME C_YELLOW
RESETBGCOLOR
PRINTL RESETBGCOLOR 后
CALL ASSERT_TRUE, 1, @"SETBGCOLOR/SETBGCOLORBYNAME/RESETBGCOLOR 不报错"
NONG += RESULT

;---- REDRAW（0=暂停重绘 / 1=恢复）----
REDRAW 0
REDRAW 1
CALL ASSERT_EQ, CURRENTREDRAW(), 1, @"REDRAW 1 后 CURRENTREDRAW 为真"
NONG += RESULT

;---- HTML 系（HTML_PRINT / HTML_TAGSPLIT / 4 个转换函数）----
HTML_PRINT "<b>HTML_PRINT 加粗</b><br>"
CALL ASSERT_SEQ, HTML_ESCAPE("<a&b>"), "&lt;a&amp;b&gt;", @"HTML_ESCAPE 转义实体"
NONG += RESULT
CALL ASSERT_SEQ, HTML_TOPLAINTEXT("<b>纯文本</b>"), "纯文本", @"HTML_TOPLAINTEXT 剥标签"
NONG += RESULT
CALL ASSERT_TRUE, 1, @"HTML_TAGSPLIT 调用不报错"
NONG += RESULT
HTML_TAGSPLIT "<b>标签</b>"
CALL ASSERT_TRUE, 1, @"HTML_GETPRINTEDSTR/HTML_POPPRINTINGSTR 可取缓冲"
NONG += RESULT
;HTML_TAGSPLIT <字符串>, <结果数组>, <个数变量>：按标签切段（对齐 C# HtmlTagSplit）
HTML_TAGSPLIT "<b>标签</b>文本", LOCALS, LOCAL
CALL ASSERT_SEQ, LOCALS:0, "<b>", @"HTML_TAGSPLIT 第 0 段 = 标签"
NONG += RESULT
CALL ASSERT_SEQ, LOCALS:1, "标签", @"HTML_TAGSPLIT 第 1 段 = 文本"
NONG += RESULT
CALL ASSERT_SEQ, LOCALS:2, "</b>", @"HTML_TAGSPLIT 第 2 段 = 结束标签"
NONG += RESULT
CALL ASSERT_SEQ, LOCALS:3, "文本", @"HTML_TAGSPLIT 第 3 段 = 尾部文本"
NONG += RESULT
CALL ASSERT_EQ, LOCAL, 4, @"HTML_TAGSPLIT 段数写入个数变量"
NONG += RESULT
HTML_TAGSPLIT "<b未闭合", LOCALS, LOCAL
CALL ASSERT_EQ, LOCAL, -1, @"HTML_TAGSPLIT 未闭合标签写 -1"
NONG += RESULT

;---- 对齐 ----
ALIGNMENT CENTER
PRINTL 居中
ALIGNMENT RIGHT
PRINTL 靠右
ALIGNMENT LEFT

;---- DRAWLINE / CUSTOMDRAWLINE ----
DRAWLINE
CUSTOMDRAWLINE --
DRAWLINE

;---- REUSELASTLINE / LINEISEMPTY ----
PRINT 会被 REUSELASTLINE 覆盖的一行
REUSELASTLINE REUSELASTLINE 覆盖了上一行
PRINTL
CALL ASSERT_TRUE, LINEISEMPTY(), @"PRINTL 空行后当前缓冲为空"
NONG += RESULT

;---- PRINTDATA（随机选择一条，只验证能输出）----
PRINTDATA
	DATA 候选甲
	DATAFORM 候选_{1 + 1}
	DATA 候选丙
ENDDATA
PRINTL （PRINTDATA 随机一条）

;---- PRINTDATAL + DATALIST ----
PRINTDATAL
	DATALIST
		DATA 列表项1
		DATA 列表项2
	ENDLIST
	DATA 独立项
ENDDATA
PRINTL （PRINTDATAL）

;---- STRDATA 赋值随机一条 ----
; STRDATA = PRINTDATA 的不显示版：段结构与 PRINTDATA 相同，但**不打印**，
; 把被选中段的文本写进变量。回归：此前 STRDATA 不在宿主名单里 -> 整段被逐行
; 当普通指令执行 -> DATA/ENDDATA 报 [未完成] 且 S 一直是空的。
;CALL 后 S 必须是段里的一条
STRDATAVAR = 0
STRDATA S
	DATA 随机串1
	DATA 随机串2
ENDDATA
SIF S == "随机串1" || S == "随机串2"
	STRDATAVAR = 1
CALL ASSERT_EQ, STRDATAVAR, 1, @"STRDATA 把所选段文本写进变量（不显示）"
PRINTFORML STRDATA -> %S%（随机一条）
PRINTL

;---- SKIPDISP（跳过显示）----
SKIPDISP 1
PRINTL 这一行不应显示
SKIPDISP 0
CALL ASSERT_TRUE, ISSKIP() == 0, @"SKIPDISP 0 后 ISSKIP 为假"
NONG += RESULT

;---- FORML 组合：PUTFORM ----
;PUTFORM 把文本放入 p バッファ（PRINTL 时一起输出）
PUTFORM PUTFORM 内容：
PRINTL 与 PUTFORM 合并输出

;---- DEBUGPRINT 族（调试模式才可见，验证不报错）----
DEBUGPRINTL DEBUGPRINTL（静默）
DEBUGPRINTFORML DEBUG {1 + 1}（静默）

;---- %…% 里含「用户字符串变量的运算」（eraTW 实机回归）----
; eraTW 的 `PRINTSINGLEFORMS "== %ARGS% " + "%(EQUAL * 150)%"`、
; `PRINTFORML %STAMP_STR * STAMP_NUM%`、`%RESULTS + 本体名称, 38, LEFT%` 都是
; 「字符串变量参与运算」的插值。用户变量类型必须在**装载期**就确定
;（ErbLoader 预扫描 #DIM/#DIMS -> LoadTimeVarTypes，早于 AstBuilder::build），
; 否则 `EQUAL * 150`（Str×Int）会被当成整数式 -> %…% 类型校验拒绝 ->
; 整个 FORM 归约失败 -> 整行**原样打印**（eraTW 的 DRAW_MAP 信息行把
; `"== %ARGS% " + "%(EQUAL * 150)%"` 原封不动显示到屏幕上）。
FORM_EQ = =
; 字符串变量赋值的右侧是 FORM 文本（eraTW 的 `ARGS += NEST_SEPARATOR` 同型）
S = [%FORM_EQ * 3%]        ;S 是 #DIMS 声明的字符串变量 -> 右侧按 FORM 文本处理
CALL ASSERT_SEQ, S, "[===]", @"字符串赋值 FORM 里的字符串变量运算不原样打印"
NONG += RESULT
; 头文件（.ERH）里声明的广域字符串变量：装载期类型表必须**跨文件**覆盖到，
; 否则 `DOC_WIDE_S27 + "!"` 会被当成整数式 -> %…% 类型校验拒绝 -> 原样打印。
DOC_WIDE_S27 = HEADER
S = [%DOC_WIDE_S27 + "!"%]
CALL ASSERT_SEQ, S, "[HEADER!]", @"ERH 广域字符串变量参与运算的 FORM 插值"
NONG += RESULT
PRINTFORML [%FORM_EQ * 2, 5, RIGHT%]（宽度/对齐）
; 与 eraTW 同形的 FORMS 语句：不再原样打印（看屏即可，无断言）。
; PRINTSINGLE 系在 C# 走 EmueraConsole.PrintSingleLine —— 作为**一行**输出
;（隐含换行），所以下面这一行会独占一行，不与后续输出粘连（否则 --check 会
; 报「区块越出 root 宽度」）。
PRINTSINGLEFORMS "== %GAMEBASE_TITLE% " + "%(FORM_EQ * 3)%"

RETURN NONG
