@startuml 03-runtime-system
!pragma layout smetana
' 运行时责任 2/4：系统状态、脚本帧底与输入等待
' 来源：GameProc/system_state_machine.h, process_state.h, script_runner.h

title 运行时：系统状态与输入等待

package "GameProc" {
  class SystemStateMachine {
    - m_state : ProcessState*
    - m_runner : ScriptRunner*
    - m_handlers : QHash<SystemStateCode, Handler>
    - m_pendingTimedWait : PendingTimedWait
    - m_prevStates : QList<SystemStateCode>
    + run() : ExecState
    + runSystemProc()
    + resume(value) : ExecState
    + resumeString(value) : ExecState
    + deliverInputValues(values) : ExecState
    + waitAnyKey()
    + waitTimedInput(ms, defaultValue, oneInput)
    + waitTimedStringInput(ms, defaultValue, oneInput)
    + waitTimedAnyKey(ms)
    + onFramePresented()
    + requestSaveLoad(save)
    .. stateChanged(old, new) ..
    .. inputKindRequested(kind, defaultValue) ..
    .. stateAdvanced(state) ..
  }

  struct SystemHost {
    + waitInput()
    + readAnyKey()
    + printSingleLine(text)
    + printTemporaryLine(text)
    + lastLineIsTemporary() : bool
    + lastLineIsEmpty() : bool
    + saveTo(index, text) : bool
    + loadFrom(index) : bool
    + checkData(index, message) : bool
  }

  class ScriptRunner {
    + runSlice(budget, time) : ExecState
    + onInputProvided(value)
    + onSystemStateChanged(state)
    + ARRAYSHIFT / ARRAYREMOVE / ARRAYSORT
    .. suspended(state) ..
    .. inputRequested(kind, defaultValue) ..
  }

  class VariableStorage {
    + getIntElement1D(name, index, scope)
    + setIntElement1D(name, index, value, scope)
    + getStrElement1D(name, index, scope)
    + setStrElement1D(name, index, value, scope)
  }

  class ProcessState {
    + getSystemState() : SystemStateCode
    + setSystemState(state)
    + getExecState() : ExecState
    + requestWaitSystemInput()
    + requestResume()
    .. execStateChanged(state) ..
    .. continueExecution() ..
  }

  enum SystemStateCode {
    Title_Begin
    Normal
    Train_WaitInput
    Shop_WaitInput
    Ablup_WaitInput
    SaveGame_WaitInput
    LoadGame_WaitInput
    LoadData_DataLoaded
  }

  enum ExecState {
    Continue
    WaitInput
    WaitSystemInput
    WaitEvent
    Halt
    Error
  }

  class QTimer <<Qt>>
}

SystemStateMachine *-- SystemHost : injected callbacks
SystemStateMachine --> ProcessState : set state / read floor
SystemStateMachine --> ScriptRunner : call function / resume
SystemStateMachine --> SystemStateCode : dispatch handler
ProcessState --> ExecState
ProcessState ..> SystemStateMachine : execStateChanged
ScriptRunner ..> ProcessState : suspended / continueExecution
SystemStateMachine ..> QTimer : arm timed wait
SystemStateMachine ..> SystemHost : output / input policy
ScriptRunner --> VariableStorage : named 1D array element access

note right of ScriptRunner
  ARRAYSHIFT, ARRAYREMOVE and ARRAYSORT accept 1D names. Their storage
  dispatch distinguishes declared/user arrays from built-in arrays: RESULT,
  LOCAL and ARG use integer slots; RESULTS uses its flat global string slots;
  LOCALS and ARGS use per-frame string slots. None of these paths should create
  a same-named shadow container. The current port treats negative, out-of-range,
  or non-positive effective ranges as a safe no-op at the command boundary;
  this is a defensive port policy, not the EE reference error contract (the
  command reference documents errors for several invalid ranges). Numeric
  arguments are range-checked before conversion to int, including INT_MIN.
  ARRAYSHIFT/REMOVE/SORT operate on the declared/configured 1D length, not on
  the number of currently allocated slots.
end note

note right of SystemStateMachine
  pump() alternates two owners:
  1. ScriptRunner runs until the call stack
     returns to the frame floor or suspends.
  2. runSystemProc() dispatches the current
     SystemStateCode handler.

  System input is non-blocking:
  SystemStateMachine::setWaitInput() calls
  ProcessState::requestWaitSystemInput(), then emits
  inputKindRequested(); resume*() writes the result,
  calls ProcessState::requestResume(), and schedules the next pump.
end note

note bottom of QTimer
  Timed input first arms PendingTimedWait.
  With a QML presentation probe, onFramePresented()
  starts the timer only after the pending model/layout work
  has been acknowledged; this does not prove pixels reached the display.
  Headless tests use the injected timer directly.
end note

legend bottom
  The callback boundary is SystemHost. The state machine does not own
  ConsoleBackend, file widgets, or QML objects.
endlegend
@enduml
