;=============================================================
; [6] 字符串函数（文档「字符串操作·引用」组全覆盖）
;=============================================================
@TEST_STRFUNC
#DIM NONG
#DIMS S
#DIMS PARTS, 10
#DIM N

PRINTL == 组6：字符串函数 ==

;---- 长度族 ----
CALL ASSERT_EQ, STRLENS("AB漢字"), 6, @"STRLENS 半角2+全角4"
NONG += RESULT
CALL ASSERT_EQ, STRLENSU("AB漢字"), 4, @"STRLENSU 字符数"
NONG += RESULT
CALL ASSERT_EQ, STRLENFORM("X{1+1}"), 2, @"STRLENFORM 展开为 X2（2 字节）"
NONG += RESULT
CALL ASSERT_EQ, STRLENFORMU("X{1+1}"), 2, @"STRLENFORMU 展开为 X2"
NONG += RESULT
CALL ASSERT_EQ, STRLENU("AB"), 2, @"STRLENU"
NONG += RESULT
CALL ASSERT_EQ, STRLENSU("AB"), 2, @"STRLENSU"
NONG += RESULT

;---- 截取 / 取字符 ----
S = "ABCDEF"
CALL ASSERT_SEQ, SUBSTRING(S, 1, 3), "BCD", @"SUBSTRING(S,1,3)"
NONG += RESULT
CALL ASSERT_SEQ, SUBSTRING(S, 4, 100), "EF", @"SUBSTRING 越界截断"
NONG += RESULT
CALL ASSERT_SEQ, SUBSTRINGU(S, 2, 2), "CD", @"SUBSTRINGU"
NONG += RESULT
CALL ASSERT_SEQ, CHARATU(S, 1), "B", @"CHARATU(S,1)"
NONG += RESULT

;---- 查找 / 统计 ----
CALL ASSERT_EQ, STRFIND("ABCABC", "C", 0), 2, @"STRFIND 首次出现"
NONG += RESULT
CALL ASSERT_EQ, STRFIND("ABCABC", "C", 3), 5, @"STRFIND 指定起点"
NONG += RESULT
CALL ASSERT_EQ, STRFINDU("AB漢字", "漢", 0), 2, @"STRFINDU"
NONG += RESULT
CALL ASSERT_EQ, STRCOUNT("aXaXa", "a"), 3, @"STRCOUNT"
NONG += RESULT

;---- 大小写 / 全半角 ----
CALL ASSERT_SEQ, TOUPPER("aBc"), "ABC", @"TOUPPER"
NONG += RESULT
CALL ASSERT_SEQ, TOLOWER("AbC"), "abc", @"TOLOWER"
NONG += RESULT
CALL ASSERT_SEQ, TOFULL("A1"), "Ａ１", @"TOFULL"
NONG += RESULT
CALL ASSERT_SEQ, TOHALF("Ａ１"), "A1", @"TOHALF"
NONG += RESULT

;---- 转换 ----
CALL ASSERT_SEQ, TOSTR(123), "123", @"TOSTR"
NONG += RESULT
CALL ASSERT_SEQ, TOSTR(123, "D5"), "00123", @"TOSTR .NET 格式 D5"
NONG += RESULT
CALL ASSERT_EQ, TOINT("42"), 42, @"TOINT"
NONG += RESULT
CALL ASSERT_EQ, TOINT("abc"), 0, @"TOINT 非数字为 0"
NONG += RESULT
CALL ASSERT_TRUE, ISNUMERIC("123"), @"ISNUMERIC 数字串"
NONG += RESULT
CALL ASSERT_TRUE, !ISNUMERIC("12a"), @"ISNUMERIC 非数字串"
NONG += RESULT

;---- 替换 / 分割 / 转义 ----
CALL ASSERT_SEQ, REPLACE("aXbXc", "X", "-"), "a-b-c", @"REPLACE 全量替换"
NONG += RESULT
;SPLIT 是命令（C# SP_SPLIT）：段数写 RESULT，结果写入字符串数组
SPLIT "a,b,c", ",", PARTS
CALL ASSERT_EQ, RESULT, 3, @"SPLIT 返回段数（写 RESULT）"
NONG += RESULT
CALL ASSERT_SEQ, PARTS:1, "b", @"SPLIT 第二段"
NONG += RESULT
CALL ASSERT_SEQ, ESCAPE("ab"), "ab", @"ESCAPE 无需转义时原样"
NONG += RESULT

;---- Unicode / 编码 ----
CALL ASSERT_SEQ, UNICODE(0x41), "A", @"UNICODE(0x41)"
NONG += RESULT
CALL ASSERT_EQ, UNICODEBYTE("A", 0), 65, @"UNICODEBYTE('A',0)"
NONG += RESULT
CALL ASSERT_EQ, ENCODETOUNI("A"), 65, @"ENCODETOUNI"
NONG += RESULT

;---- 拼接 / 格式化 ----
PARTS:0 = "a"
PARTS:1 = "b"
PARTS:2 = "c"
CALL ASSERT_SEQ, STRJOIN(PARTS, "-", 0, 3), "a-b-c", @"STRJOIN 指定连接符（显式区间）"
NONG += RESULT
CALL ASSERT_SEQ, STRFORM("%TOSTR(1+2)%"), "3", @"STRFORM 展开"
NONG += RESULT

;---- 金额 / 其它 ----
CALL ASSERT_SEQ, MONEYSTR(1234567), "$1234567", @"MONEYSTR 默认单位 $"
NONG += RESULT

RETURN NONG
