;=============================================================
; [4] 调用系：CALL/CALLFORM/TRYCALL/TRYC*/JUMP 系/CALLF/RETURN
;=============================================================
@TEST_CALL_JUMP
#DIM NONG

PRINTL == 组4：调用 CALL/JUMP/式中函数 ==

;---- CALL + RETURN ----
CALL ADDTEN, 5
CALL ASSERT_EQ, RESULT, 15, "CALL ADDTEN, 5 -> RESULT 15"
NONG += RESULT

;---- 逗号形式与括号形式等价 ----
CALL ADDTEN(6)
CALL ASSERT_EQ, RESULT, 16, "CALL 括号形式"
NONG += RESULT

;---- CALLFORM（格式串函数名）----
CALLFORM ADDTEN_%TOSTR(7)%
CALL ASSERT_EQ, RESULT, 17, "CALLFORM ADDTEN_%7%"
NONG += RESULT

;---- TRYCALL：存在 / 不存在 ----
TRYCALL ADDTEN, 1
CALL ASSERT_EQ, RESULT, 11, "TRYCALL 存在则调用"
NONG += RESULT
TRYCALL NO_SUCH_FUNC_XYZ
CALL ASSERT_TRUE, 1, "TRYCALL 不存在静默跳过"
NONG += RESULT

;---- TRYCALLFORM：不存在静默跳过 ----
TRYCALLFORM NO_SUCH_%TOSTR(1)%
CALL ASSERT_TRUE, 1, "TRYCALLFORM 不存在静默跳过"
NONG += RESULT

;---- TRYCCALL / CATCH：存在不进 CATCH ----
TRYCCALL ADDTEN, 2
CATCH
	PRINTL 不应进入 CATCH
ENDCATCH
CALL ASSERT_EQ, RESULT, 12, "TRYCCALL 存在 -> 不进 CATCH"
NONG += RESULT

;---- TRYCCALL / CATCH：不存在进 CATCH ----
TRYCCALL NO_SUCH_FUNC_XYZ
CATCH
	PRINTL （TRYCCALL 失败 -> 进入 CATCH）
ENDCATCH
CALL ASSERT_TRUE, 1, "TRYCCALL 不存在 -> 进 CATCH"
NONG += RESULT

;---- TRYCJUMP（JUMP 语义：目标 RETURN 后直接回到**调用者的调用者**）----
CALL SUB_TESTTRYCJUMP
CALL ASSERT_EQ, RESULT, 13, "TRYCJUMP 的目标 RETURN 后回到调用者"
NONG += RESULT

;---- JUMP（同上；JUMP 行之后的代码被跳过）----
CALL SUB_TESTJUMP
CALL ASSERT_EQ, RESULT, 14, "JUMP 的目标 RETURN 后回到调用者"
NONG += RESULT

PRINTL PRE_GOTOFORM
;---- GOTOFORM（$ 标签，FORM 变体）----
PRINTFORML GT=[GOTOLABEL_%TOSTR(1)%]
GOTOFORM GOTOLABEL_%TOSTR(1)%
PRINTL 不应执行到这里（GOTOFORM 已跳走）
$GOTOLABEL_1
CALL ASSERT_TRUE, 1, "GOTOFORM 跳到 $GOTOLABEL_1"
NONG += RESULT

;---- TRYGOTOFORM：不存在的标签静默跳过 ----
TRYGOTOFORM NO_SUCH_LABEL_%TOSTR(9)%
CALL ASSERT_TRUE, 1, "TRYGOTOFORM 不存在静默跳过"
NONG += RESULT

;---- CALLF / CALLFORMF（对齐 C#：返回值**不**落任何寄存器，仅求副作用）----
;注意：ASSERT_EQ 自身以 RETURN 收尾会改写 RESULT，故先用局部变量接住
CALL SUB_TEST_CALLF
CALL ASSERT_EQ, RESULT, 1, "CALLF/CALLFORMF 均不改写 RESULT"
NONG += RESULT

;---- 省略实参（空位）占位：后续实参不得左移（对齐 C# 的实参 null）----
; eraTW 的 `CALLF OBJNAME_TO_ID(, "RESET", CLASS_NAME)` 依赖这里：空位被丢弃
; 会让 "RESET" 顶到第 1 个形参，角色列表初始化链整体失效（CHECK_CHARA 抛 THROW）。
; 式中调用（表达式路径）
CALL ASSERT_EQ, OMIT4(, 2, 3, 4), 234, "式中调用 首位省略实参不左移"
NONG += RESULT
CALL ASSERT_EQ, OMIT4(1, , 3, 4), 1034, "式中调用 中间省略实参不左移"
NONG += RESULT
CALL ASSERT_EQ, OMIT4(1, 2, , 4), 1204, "式中调用 他位省略实参不左移"
NONG += RESULT
; 语句 CALL：逗号形式（eraTW `CALL PRINT_FACE, ARG, "顔" ,,, "差分"`）与括号形式
CALL OMIT4_STMT, 1, , 3, 4
CALL ASSERT_EQ, RESULT, 1034, "CALL 逗号形式省略实参不左移"
NONG += RESULT
CALL OMIT4_STMT(1, 2, 3, 4)
CALL ASSERT_EQ, RESULT, 1234, "CALL 无省略时与原来一致"
NONG += RESULT
; 语句 CALLF：省略在**首位**（正是 OBJNAME_TO_ID 的形态；返回值丢弃，看副作用）
CALLF OMIT4_CALLF(, 2, 3, 4)
CALL ASSERT_SEQ, RESULTS:0, "0_2_3_4", "CALLF 首位省略实参不左移"
NONG += RESULT
; 省略位取声明的缺省值（C#：实参 null -> func.Def[i]）
CALL ASSERT_EQ, OMIT4DEF(1, , 4), 1740, "式中调用 省略位取声明缺省值（B=7）"
NONG += RESULT
CALL OMITDEF_STMT, 1, , 4
CALL ASSERT_EQ, RESULT, 1740, "CALL 省略位取声明缺省值（B=7）"
NONG += RESULT

;---- 普通字符串返回与 #FUNCTIONS ----
CALL MAKEMSG
CALL ASSERT_SEQ, RESULTS:0, "RETURNFORM结果", "字符串返回写 RESULTS:0"
NONG += RESULT
; 返回值本身（#FUNCTIONS 字符串函数路径：调用方读的是返回值，不是 RESULTS）
CALL ASSERT_SEQ, MSGFUNC(), "值-2", "RETURNF 的 FORM 字符串返回值（{…} 已展开）"
NONG += RESULT

RETURN NONG

;=============================================================
; 被调函数们
;=============================================================
@ADDTEN(X)
RETURN X + 10

@ADDTEN_7
RETURN 17

@GETTEN(X)
#FUNCTION
RETURNF X

;---- 省略实参回归用例的被调函数（A/B/C/D -> 千百十个）----
@OMIT4(A, B, C, D)
#FUNCTION
RETURNF A * 1000 + B * 100 + C * 10 + D

@OMIT4DEF(A, B = 7, C, D)
#FUNCTION
RETURNF A * 1000 + B * 100 + C * 10 + D

@OMIT4_STMT(A, B, C, D)
RETURN A * 1000 + B * 100 + C * 10 + D

@OMITDEF_STMT(A, B = 7, C, D)
RETURN A * 1000 + B * 100 + C * 10 + D

;CALLF 丢弃返回值，用 RESULTS:0 观察实参绑定
@OMIT4_CALLF(A, B, C, D)
#FUNCTION
RESULTS:0 '= TOSTR(A) + "_" + TOSTR(B) + "_" + TOSTR(C) + "_" + TOSTR(D)
RETURNF 0

@MAKEMSG
RESULTS:0 = RETURNFORM结果
RETURN

@MSGFUNC
#FUNCTIONS
RETURNF @"值-{1 + 1}"

;TRYCJUMP 跳到 ADDTEN；ADDTEN 的 RETURN 沿 JUMP 帧直接回到 TEST_CALL_JUMP
@SUB_TESTTRYCJUMP
TRYCJUMP ADDTEN, 3
RETURN -1

;JUMP 跳到 JUMPTARGET14；同上不回到本函数
@SUB_TESTJUMP
JUMP JUMPTARGET14
RETURN -1

@JUMPTARGET14
RETURN 14

;CALLF / CALLFORMF 的「不改写 RESULT」验证：内部先置 RESULT=7，两种调用后仍是 7
@SUB_TEST_CALLF
RESULT = 7
CALLF GETTEN(4)
SIF RESULT != 7
	RETURN 0
CALLFORMF GETTEN(5)
SIF RESULT != 7
	RETURN 0
RETURN 1
