;========================================================================
; M) CBG 家族（ClientBackground · Command.html「图像处理相关」）
;    客户端区域背景图像：按 zdepth 与文字分层（负 z 画在文字前）。
;    本组只做数据层/返回值断言（渲染消费在 GUI 抓帧里看）。
;    返回值对齐 C# Creator.Method.cs：
;      CBGSETG/CBGSETBMAPG 需 G 存在；CBGSETSPRITE 需精灵/静态资源存在；
;      CBGSETBUTTONSPRITE 只校验按钮值 0..0xFFFFFF（精灵可空串/不存在）；
;      CBGREMOVERANGE / CBGCLEAR / CBGCLEARBUTTON / CBGREMOVEBMAP 恒返回 1。
;========================================================================
GID2 = 3420
CALL ASSERT_EQ, GCREATE(GID2, 8, 8), 1, @"CBG 用 G 8×8"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETG(GID2, 0, 0, 1), 1, @"CBGSETG(存在的 G) = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETG(9999, 0, 0, 1), 0, @"CBGSETG(不存在的 G) = 0"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETBMAPG(GID2), 1, @"CBGSETBMAPG(存在的 G) = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETBMAPG(9999), 0, @"CBGSETBMAPG(不存在的 G) = 0"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETSPRITE("off_part", 0, 0, 2), 1, @"CBGSETSPRITE(存在的静态资源) = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETSPRITE("no_such_sprite_xyz", 0, 0, 2), 0, @"CBGSETSPRITE(不存在) = 0"
FAILS += RESULT
;C# CBGSETBUTTONSPRITE <按钮值>, <精灵名>, <选中精灵名>, <x>, <y>, <z>{, <tooltip>}
CALL ASSERT_EQ, CBGSETBUTTONSPRITE(7, "off_part", "off_base", 0, 0, 3), 1, @"CBGSETBUTTONSPRITE(6 参) = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETBUTTONSPRITE(8, "off_part", "off_base", 0, 0, 3, "提示"), 1, @"CBGSETBUTTONSPRITE(7 参 + tooltip) = 1"
FAILS += RESULT
;精灵名允许空串、甚至不存在（C# 不校验精灵）；只校验按钮值范围 0..0xFFFFFF
CALL ASSERT_EQ, CBGSETBUTTONSPRITE(9, "", "", 0, 0, 3), 1, @"CBGSETBUTTONSPRITE(空精灵名) = 1（C# 不校验精灵）"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETBUTTONSPRITE(-1, "off_part", "", 0, 0, 3), 0, @"CBGSETBUTTONSPRITE(按钮值 -1) = 0"
FAILS += RESULT
CALL ASSERT_EQ, CBGSETBUTTONSPRITE(16777216, "off_part", "", 0, 0, 3), 0, @"CBGSETBUTTONSPRITE(按钮值 0x1000000) = 0"
FAILS += RESULT
CALL ASSERT_EQ, CBGREMOVERANGE(3, 3), 1, @"CBGREMOVERANGE 恒返回 1（删 z=3 的按钮层）"
FAILS += RESULT
CALL ASSERT_EQ, CBGREMOVERANGE(3, 3), 1, @"CBGREMOVERANGE 再次调用仍返回 1（已无层）"
FAILS += RESULT
CALL ASSERT_EQ, CBGREMOVERANGE(0, 10), 1, @"CBGREMOVERANGE(0,10) 删掉剩余层 = 1"
FAILS += RESULT
;CBGCLEAR/CBGCLEARBUTTON/CBGREMOVEBMAP 也是纯动作，恒返回 1
CBGSETG(GID2, 0, 0, 1)
CBGSETBUTTONSPRITE(5, "off_part", "off_base", 0, 0, 4)
CALL ASSERT_EQ, CBGCLEARBUTTON, 1, @"CBGCLEARBUTTON = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGREMOVEBMAP, 1, @"CBGREMOVEBMAP = 1"
FAILS += RESULT
CALL ASSERT_EQ, CBGCLEAR, 1, @"CBGCLEAR = 1"
FAILS += RESULT
CALL ASSERT_EQ, GDISPOSE(GID2), 1, @"GDISPOSE(CBG 用 G)"
FAILS += RESULT

